map $status $citybikes_status_class {
        ~^(?<first>[1-5])  ${first}xx;
    }

    map $status $citybikes_error {
        ~^5      1;
        default  0;
    }

    map $uri $citybikes_route {
        ~^(?<api>/api/[a-z/]+)$  $api;
        default                  static;
    }

    map $http_user_agent $citybikes_log {
        ~^Wget   0;
        default  1;
    }

log_format citybikes 'status=$status class=$citybikes_status_class route=$citybikes_route '
                     'err=$citybikes_error rt=$request_time urt=$upstream_response_time';

server {
    access_log /var/log/nginx/access.log citybikes if=$citybikes_log;
    
    listen 8080;
    server_name _;

    include /etc/nginx/tls/*.conf;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;

    # The browser talks to ONE origin; /api goes to the History service.
    location /api/ {
        proxy_pass ${HISTORY_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # History is down: the same JSON error the UI already understands.
    error_page 502 503 504 = @history_down;
    location @history_down {
        default_type application/json;
        return 502 '{"error": "history service unreachable"}';
    }

    # Vite file names contain a content hash: cache them for a year.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;   # index.html must always be fresh, it points at the hashed assets
        try_files $uri /index.html;
    }
}
