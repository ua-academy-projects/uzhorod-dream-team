{
  "ansible_user": "phantom_s",
  "project_id": "project-a5588ddc-4a2e-4c04-879",
  "region": "europe-west4",
  "zone": "europe-west4-a",
  "bootstrap": {
    "project_name": "Data Monitor",
    "service_account_id": "terraform-deployer",
    "service_account_name": "Terraform infrastructure deployer",
    "bucket_name": "project-a5588ddc-4a2e-4c04-879-tfstate",
    "state_prefix": "datamonitor/dev"
  },
  "network": {
    "name": "analyzer-vpc",
    "subnet": {
      "name": "analyzer-subnet",
      "cidr": "10.10.0.0/24",
      "region": "europe-west4"
    },
    "nat": {
      "name": "analyzer-nat",
      "enabled": true
    }
  },
  "firewall": {
    "rules": [
      {
        "name": "allow-ui-web",
        "target_tags": [
          "ui-service"
        ],
        "source_ranges": [
          "0.0.0.0/0"
        ],
        "allowed": [
          {
            "protocol": "tcp",
            "ports": [
              "80",
              "443"
            ]
          }
        ]
      },
      {
        "name": "allow-iap-bastion",
        "target_tags": [
          "bastion-service"
        ],
        "allowed": [
          {
            "protocol": "tcp",
            "ports": [
              "56789"
            ]
          }
        ],
        "source_ranges": [
          "35.235.240.0/20"
        ]
      },
      {
        "name": "allow-bastion-ssh",
        "target_tags": [
          "fetcher-service",
          "history-service",
          "postgres-service",
          "ui-service"
        ],
        "allowed": [
          {
            "protocol": "tcp",
            "ports": [
              "22"
            ]
          }
        ],
        "source_tags": [
          "bastion-service"
        ]
      },
      {
        "name": "allow-ui-history",
        "target_tags": [
          "history-service"
        ],
        "allowed": [
          {
            "protocol": "tcp",
            "ports": [
              "8000"
            ]
          }
        ],
        "source_tags": [
          "ui-service"
        ]
      },
      {
        "name": "allow-history-fetcher",
        "target_tags": [
          "fetcher-service"
        ],
        "allowed": [
          {
            "protocol": "tcp",
            "ports": [
              "8000"
            ]
          }
        ],
        "source_tags": [
          "history-service"
        ]
      },
      {
        "name": "allow-app-postgres",
        "target_tags": [
          "postgres-service"
        ],
        "allowed": [
          {
            "protocol": "tcp",
            "ports": [
              "5432"
            ]
          }
        ],
        "source_tags": [
          "fetcher-service",
          "history-service"
        ]
      },
      {
        "name": "allow-app-rabbitmq",
        "target_tags": [
          "postgres-service"
        ],
        "allowed": [
          {
            "protocol": "tcp",
            "ports": [
              "5672"
            ]
          }
        ],
        "source_tags": [
          "fetcher-service",
          "history-service"
        ]
      },
      {
        "name": "allow-ui-redis",
        "target_tags": [
          "postgres-service"
        ],
        "allowed": [
          {
            "protocol": "tcp",
            "ports": [
              "6379"
            ]
          }
        ],
        "source_tags": [
          "ui-service"
        ]
      }
    ]
  },
  "secret_manager": {
    "secret_id": "datamonitor-env",
    "account_id": "datamonitor-vm",
    "display_name": "Data Monitor VM Service Account",
    "roles": [
      "roles/secretmanager.secretAccessor"
    ],
    "services": {
      "fetcher": {
        "secret_id": "datamonitor-fetcher-env",
        "account_id": "datamonitor-fetcher",
        "display_name": "Data Monitor fetcher VM"
      },
      "postgres": {
        "secret_id": "datamonitor-postgres-env",
        "account_id": "datamonitor-postgres",
        "display_name": "Data Monitor postgres VM"
      },
      "history": {
        "secret_id": "datamonitor-history-env",
        "account_id": "datamonitor-history",
        "display_name": "Data Monitor history VM"
      },
      "ui": {
        "secret_id": "datamonitor-ui-env",
        "account_id": "datamonitor-ui",
        "display_name": "Data Monitor ui VM"
      }
    }
  },
  "compute": {
    "defaults": {
      "machine_type": "e2-small",
      "boot_disk": {
        "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64",
        "size_gb": 15,
        "type": "pd-standard"
      },
      "public_ip": false,
      "attach_service_account": true
    },
    "instances": {
      "bastion": {
        "name": "bastion-instance",
        "machine_type": "e2-micro",
        "network_ip": "10.10.0.11",
        "tags": [
          "bastion-service"
        ],
        "public_ip": false,
        "attach_service_account": false,
        "boot_disk": {
          "size_gb": 10
        },
        "startup": {
          "type": "bastion",
          "ssh_port": 56789
        },
        "static_public_ip": false
      },
      "fetcher": {
        "name": "fetcher-instance",
        "network_ip": "10.10.0.12",
        "tags": [
          "fetcher-service",
          "internal-service"
        ],
        "startup": {
          "type": "none"
        }
      },
      "postgres": {
        "name": "postgres-instance",
        "network_ip": "10.10.0.13",
        "tags": [
          "postgres-service",
          "internal-service"
        ],
        "startup": {
          "type": "none"
        }
      },
      "history": {
        "name": "history-instance",
        "network_ip": "10.10.0.14",
        "tags": [
          "history-service",
          "internal-service"
        ],
        "startup": {
          "type": "none"
        }
      },
      "ui": {
        "name": "ui-instance",
        "network_ip": "10.10.0.15",
        "tags": [
          "ui-service"
        ],
        "startup": {
          "type": "none",
          "ip_https": true
        },
        "public_ip": true,
        "static_public_ip": true
      }
    },
    "application": {
      "repo_url": "https://github.com/ua-academy-projects/uzhorod-dream-team.git",
      "repo_branch": "dmytro/btc-eth-price-analyzer",
      "app_backend": "hybrid"
    }
  },
  "cloud_sql": {
    "instance_name": "datamonitor",
    "database_version": "POSTGRES_18",
    "region": "europe-west4",
    "zone": "europe-west4-a",
    "tier": "db-perf-optimized-N-8",
    "public_ip": false,
    "deletion_protection": true,
    "edition": "ENTERPRISE_PLUS"
  },
  "database": {
    "provider": "cloud_sql",
    "name": "history"
  },
  "registry": {
    "repository_id": "datamonitor"
  },
  "ssh": {
    "iap_enabled": true
  }
}
