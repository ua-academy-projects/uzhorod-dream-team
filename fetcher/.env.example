# RabbitMQ: the Fetcher consumes requests from a queue and publishes replies (no HTTP API)
AMQP_URL=amqp://guest:guest@localhost:5672/

# Open-Meteo forecast API (no API key needed)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Default location, used only by the CLI script (npm run fetch-once -w fetcher).
# Queue requests carry the location from the caller (the History service).
LOCATION_NAME=Berlin
LATITUDE=52.52
LONGITUDE=13.41

# The Fetcher reads fetcher/.env from its working directory (run it from the fetcher/ folder).
# Real environment variables override values from the file.
