# Copy this file to .env:  cp .env.example .env
# .env is not committed to Git (see .gitignore).

# Mode: rabbitmq (queue in RabbitMQ) or postgres (queue tables in PostgreSQL).
APP_MODE=rabbitmq

# RabbitMQ connection: amqp://user:password@host:port/vhost
# Replace CHANGE_ME with RABBITMQ_PASSWORD from the root .env.
AMQP_URL=amqp://weather:CHANGE_ME@10.10.10.10:5672/weather

# City and its coordinates
CITY_NAME=Lviv
CITY_LATITUDE=49.84
CITY_LONGITUDE=24.03

# How many seconds to wait for a response from Open-Meteo
OPEN_METEO_TIMEOUT_SECONDS=10

# Only for APP_MODE=postgres.
# Role weather_fetcher; replace CHANGE_ME with FETCHER_DB_PASSWORD from the root .env.
DATABASE_URL=postgresql://weather_fetcher:CHANGE_ME@10.10.10.10:5432/weather_history?sslmode=require&connect_timeout=10
# How often to look into weather_requests when it is empty (only a query to the table).
QUEUE_POLL_INTERVAL_SECONDS=5
# How long a taken request belongs to this Fetcher; at least 4 x OPEN_METEO_TIMEOUT_SECONDS + 10.
QUEUE_LEASE_SECONDS=60
