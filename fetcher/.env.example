OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter
PORT=8080

# Queue: amqp(s)://… -> RabbitMQ, postgres://… -> pgmq; without the variable publishing is disabled
#QUEUE_URL=postgres://user:pass@localhost:5432/db

# The cache is paired with the queue by the QUEUE_URL scheme (there is no separate variable):
#   amqp(s)://…    -> Redis from REDIS_URL (without REDIS_URL the cache is disabled)
#   postgres(ql):// -> cache table (hstore) in the same DB as QUEUE_URL
#REDIS_URL=redis://localhost:6379

# Cache TTL in seconds (default 3600)
#CACHE_TTL_SECS=3600
