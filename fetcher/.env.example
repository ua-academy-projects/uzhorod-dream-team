# Application Environment (e.g. development, production)
ENVIRONMENT=development

# Server configuration
PORT=8080

# OpenAQ API configuration
OPENAQ_URL=https://api.openaq.org
OPENAQ_API_KEY=your_openaq_api_key_here

# HTTP client configuration (e.g., 5s, 10s, 1m)
HTTP_TIMEOUT=10s

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_REQUEST_QUEUE=fetcher.sync.requests.v1
RABBITMQ_CONNECTION_TIMEOUT=5s
RABBITMQ_RECONNECT_INTERVAL=5s

POSTGRES_ONLY=false
DATABASE_URL=postgres://kyiv_air_fetcher:password@localhost:5432/history_db?sslmode=disable
