# Token of a Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels -> your tunnel -> Configure -> token).
# In the tunnel's "Public hostname" point the hostname you own to the service http://localhost:80.
# Copy this file to deploy/cloudflared.env (it is gitignored) and put the real token in.
# Then: vagrant provision bastion --provision-with cloudflared-env,cloudflared
TUNNEL_TOKEN=
