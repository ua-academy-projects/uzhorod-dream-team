# 0 = RabbitMQ + Redis, 1 = pgmq + hstore (the cache lives in the same DB as PGMQ_URL).
# Empty or anything other than 0/1 behaves like 0. Switch with: deploy/set-queue.sh [0|1]
PG_BACKEND=0

RABBITMQ_URL=amqp://user:pass@10.10.0.30:5672/%2f
REDIS_URL=redis://:pass@10.10.0.30:6379
PGMQ_URL=postgres://user:pass@10.10.0.25:5432/db
