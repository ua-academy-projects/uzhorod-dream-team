# HTTP port of the History service
PORT=3001

# PostgreSQL connection (matches the root .env used by docker-compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/weather

# Location to track (default: Berlin)
LOCATION_NAME=Berlin
LATITUDE=52.52
LONGITUDE=13.41

# RabbitMQ: requests to the Fetcher go through a queue, replies come back through a queue
AMQP_URL=amqp://guest:guest@localhost:5672

# Optional: if set, POST /api/weather/fetch and /api/weather/backfill require header X-Trigger-Token
TRIGGER_TOKEN=

# On start, fetch the hourly history missed while the app was down (max 92 days)
CATCH_UP_ON_START=true
# Days to load if the database is empty
INITIAL_BACKFILL_DAYS=30

# Redis cache for UI preferences (theme)
REDIS_URL=redis://localhost:6379
