# Where to read from: amqp(s)://… -> RabbitMQ, postgres://… -> pgmq (the same QUEUE_URL as the fetcher)
QUEUE_URL=postgres://user:pass@localhost:5432/db

# Where to write the history (may be the same DB as pgmq)
DATABASE_URL=postgres://user:pass@localhost:5432/history

# /healthz and /stats; default 8081
#PORT=8081
#RUST_LOG=info,sqlx=error
