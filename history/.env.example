ENVIRONMENT=development
PORT=8081
DATABASE_URL=postgres://user:password@localhost:5432/history_db?sslmode=disable
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

SYNC_INTERVAL=15m
BACKFILL_THRESHOLD=1h
DEFAULT_BACKFILL_DURATION=720h
FETCHER_TIMEOUT=1m

REDIS_URL=redis://localhost:6379/0
SESSION_TTL=720h
SESSION_COOKIE_SECURE=false
SESSION_STORE_TIMEOUT=1s

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_REQUEST_QUEUE=fetcher.sync.requests.v1
RABBITMQ_CONNECTION_TIMEOUT=5s
RABBITMQ_RECONNECT_INTERVAL=5s

POSTGRES_ONLY=false
