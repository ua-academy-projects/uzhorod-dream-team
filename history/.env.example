# Copy this file to .env:  cp .env.example .env
# and in DATABASE_URL replace the placeholder with the PostgreSQL password of the weather user.
# .env is not committed to Git (see .gitignore).

# Database connection: postgres://user:password@host:port/database
DATABASE_URL=postgres://weather:CHANGE_ME@localhost:5432/weather_history

# Where History serves the website and API: address:port.
# 127.0.0.1 — this computer only; 0.0.0.0 — all network interfaces (in the VM).
HISTORY_ADDR=127.0.0.1:8080

# RabbitMQ connection: amqp://user:password@host:port/vhost
# Replace CHANGE_ME with RABBITMQ_PASSWORD from the root .env.
AMQP_URL=amqp://weather:CHANGE_ME@10.10.10.10:5672/weather

# Redis connection (UI settings): redis://:password@host:port/database-number
# Replace CHANGE_ME with REDIS_PASSWORD from the root .env.
REDIS_URL=redis://:CHANGE_ME@10.10.10.10:6379/0

# How often to put a weather request into the queue
FETCH_INTERVAL=5m
