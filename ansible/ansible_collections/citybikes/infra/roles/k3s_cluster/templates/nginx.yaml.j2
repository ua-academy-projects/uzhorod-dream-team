# Managed by Ansible (role citybikes.infra.k3s_cluster): do not edit it in the cluster.
# nginx on every worker: a DaemonSet (one pod per node it may run on), the nodes chosen by node affinity.
apiVersion: v1
kind: Namespace
metadata:
  name: edge
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: nginx
  namespace: edge
  labels:
    app: nginx
spec:
  selector:
    matchLabels:
      app: nginx
  updateStrategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        app: nginx
    spec:
      affinity:
        nodeAffinity:
          # only the workers (the label every worker gets from Ansible's k3s configuration)
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: citybikes.io/role
                    operator: In
                    values: [worker]
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: nginx
          image: {{ k3s_cluster_nginx_image }}
          ports:
            - name: http
              containerPort: 8080
              hostPort: 80   # the node's own port 80: the edge of the cluster on every worker
          readinessProbe:
            httpGet:
              path: /
              port: http
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
