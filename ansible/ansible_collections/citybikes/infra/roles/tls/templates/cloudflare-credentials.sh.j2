#!/bin/sh
# Managed by Ansible (role citybikes.infra.tls): do not edit it here.
# The Cloudflare API token for certbot, as a file only while certbot runs: in /run (memory, gone at reboot).
# The VM's own service account reads it from Secret Manager.
set -eu
PATH="$PATH:/snap/bin"
case "${1:-}" in
  write)
    install -d -m 0700 "$(dirname {{ tls_credentials }})"
    token="$(gcloud secrets versions access latest --secret={{ tls_cloudflare_secret }} --quiet)"
    umask 077
    printf 'dns_cloudflare_api_token = %s\n' "$token" > {{ tls_credentials }}
    ;;
  remove)
    rm -f {{ tls_credentials }}
    ;;
  *)
    echo "usage: $0 write|remove" >&2
    exit 2
    ;;
esac