#!/usr/bin/env python3
import base64
import json
import os
import sys
import time
import urllib.error
import urllib.request

METADATA_URL = os.environ.get("ISS_METADATA_URL", "http://metadata.google.internal/computeMetadata/v1")
SECRETMANAGER_URL = os.environ.get("ISS_SECRETMANAGER_URL", "https://secretmanager.googleapis.com/v1")
SECRETS_LIST = os.environ.get("ISS_SECRETS_LIST", "/opt/iss/secrets.list")
BAD = set("$#'\"")
RETRY_DELAYS = [1, 2, 4]


class Failure(Exception):
    pass


def fail(name, reason):
    sys.stderr.write("iss-run: %s: %s\n" % (name, reason))
    sys.exit(1)


def get(url, headers):
    request = urllib.request.Request(url, headers=headers)
    for delay in RETRY_DELAYS + [None]:
        try:
            with urllib.request.urlopen(request, timeout=10) as response:
                return response.read()
        except urllib.error.HTTPError as e:
            failure = Failure("HTTP %d" % e.code)
            if e.code != 429 and e.code < 500:
                raise failure
        except (urllib.error.URLError, OSError) as e:
            failure = Failure(str(getattr(e, "reason", e)))
        if delay is None:
            raise failure
        time.sleep(delay)


def read_names():
    try:
        with open(SECRETS_LIST) as f:
            return [line.strip() for line in f if line.strip()]
    except OSError as e:
        fail("secrets.list", e.strerror or str(e))


def read_secrets(names):
    flavor = {"Metadata-Flavor": "Google"}
    try:
        project = get(METADATA_URL + "/project/project-id", flavor).decode().strip()
        token = json.loads(get(METADATA_URL + "/instance/service-accounts/default/token", flavor))["access_token"]
    except (Failure, ValueError, KeyError) as e:
        fail("metadata", e)
    auth = {"Authorization": "Bearer " + token}
    values = {}
    for name in names:
        url = "%s/projects/%s/secrets/%s/versions/latest:access" % (SECRETMANAGER_URL, project, name)
        try:
            body = json.loads(get(url, auth))
            value = base64.b64decode(body["payload"].get("data", "")).decode("utf-8")
        except Failure as e:
            fail(name, e)
        except (ValueError, KeyError, TypeError):
            fail(name, "bad response")
        if not value:
            fail(name, "empty")
        if any(c in BAD or c.isspace() for c in value):
            fail(name, "bad character")
        values[name] = value
    return values


def main():
    if len(sys.argv) < 2:
        sys.stderr.write("usage: iss-run COMMAND [ARGS...]\n")
        sys.exit(2)
    names = read_names()
    secrets = read_secrets(names) if names else {}
    os.execvpe(sys.argv[1], sys.argv[1:], dict(os.environ, **secrets))


if __name__ == "__main__":
    main()
