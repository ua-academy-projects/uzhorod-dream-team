[Unit]
Description=ISS tracker containers
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/iss-compose up -d --remove-orphans
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
