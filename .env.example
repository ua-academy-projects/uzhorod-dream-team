# Copy to .env and set a password. .env is not committed to Git.
# Vagrantfile passes it to PostgreSQL (db VM) and History (history VM).
# Use only letters and digits: the password becomes part of DATABASE_URL.
WEATHER_DB_PASSWORD=change-me

# RabbitMQ password (message queue in weather-vm), at least 16 letters or digits.
# A good one: openssl rand -hex 16
RABBITMQ_PASSWORD=change-me

# Redis password (cache for the UI settings in weather-vm), at least 16 letters or digits.
# A good one: openssl rand -hex 16
REDIS_PASSWORD=change-me

# Password of the PostgreSQL role weather_fetcher (Fetcher in app_mode postgres),
# at least 16 letters or digits. A good one: openssl rand -hex 16
FETCHER_DB_PASSWORD=change-me

# Optional: Wi-Fi IPv4 of this laptop, to open UI from a phone in the home LAN.
# Empty: UI only on 127.0.0.1. Also needs a Windows Firewall rule (see README).
UI_LAN_IP=
