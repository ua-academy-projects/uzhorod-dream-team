# Used by docker-compose.yml for the (generic, reusable) PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Database created on first start; the weather app stores its table here
POSTGRES_DB=weather
POSTGRES_PORT=5432

# Cache and queue between History and Fetcher (Vagrant; locally set it in history/.env and fetcher/.env):
# true = Redis + RabbitMQ + plain PostgreSQL; false = PostgreSQL only, with pgmq queues and an UNLOGGED cache
# table cleaned by pg_cron (Redis and RabbitMQ are not started).
# Only the value provisioning starts with; switch at run time with weather-backend (see README).
USE_REDIS_RABBITMQ=true

# Vagrant: password of the PostgreSQL role the Fetcher uses for the pgmq queues
FETCHER_DB_PASSWORD=fetcher

# Vagrant: shared secrets, read by the Vagrantfile (no default password)
TRIGGER_TOKEN=

# Cron schedule of the scheduler VM (no quotes): every hour
CRON_SCHEDULE=0 * * * *

# Host interface to bridge the frontend VM into the LAN (list: ip -br link); empty = Vagrant asks
BRIDGE_IF=wlp4s0

# Redis on the DB VM (UI preferences cache); simple value for local checks, change it for anything real
REDIS_PASSWORD=redis

# RabbitMQ on the DB VM (queues between History and Fetcher; also the management UI login "weather")
RABBITMQ_PASSWORD=rabbitmq

# Ports of the services on the VMs (optional, these are the defaults). POSTGRES_PORT is above.
HISTORY_PORT=3001
FRONTEND_PORT=4173
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Days to keep logs: journald on every VM and the collected archives on the History VM
LOG_RETENTION_DAYS=7
