#!/bin/bash
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin

REDIS_IMAGE=redis:7-alpine@sha256:8da19c7399dca900c6822a1cf30f9d2285585e2c4b457ff4095b0f4500054d3f

umask 077
mkdir -p /run/crypto

REDIS_PASSWORD=$(gcloud secrets versions access latest --secret=crypto-redis-password --project="{{ project_id }}")

cat > /run/crypto/redis.env <<EOF
REDIS_PASSWORD=$REDIS_PASSWORD
EOF

cat > /run/crypto/redis.conf <<EOF
requirepass $REDIS_PASSWORD
EOF
chmod 644 /run/crypto/redis.conf

mkdir -p /var/lib/crypto/redis

docker pull "$REDIS_IMAGE"
docker rm -f crypto_redis >/dev/null 2>&1 || true

exec docker run --rm \
--name crypto_redis \
--env-file /run/crypto/redis.env \
-v /run/crypto/redis.conf:/usr/local/etc/redis/redis.conf:ro \
-p 6379:6379 \
-v /var/lib/crypto/redis:/data \
--health-cmd 'REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli ping | grep -q PONG' \
--health-interval 5s \
"$REDIS_IMAGE" redis-server /usr/local/etc/redis/redis.conf --appendonly yes
