#!/bin/bash
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin

PSQL_IMAGE=postgres:17-alpine@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b
PGPASSWORD=$(gcloud secrets versions access latest --secret="{{ db_password_secret }}" --project="{{ project_id }}")
QUEUE_PASSWORD=$(gcloud secrets versions access latest --secret=crypto-db-queue-worker-password --project="{{ project_id }}")

export PGPASSWORD QUEUE_PASSWORD

docker run --rm -i -e PGPASSWORD -e QUEUE_PASSWORD \
-v /etc/crypto/db-ca.pem:/certs/db-ca.pem:ro "$PSQL_IMAGE" psql -q \
-v ON_ERROR_STOP=1 \
"host={{ db_host }} port=5432 dbname={{ db_name }} user={{ db_user }} sslmode=verify-ca sslrootcert=/certs/db-ca.pem" <<'SQL'
DO $$
BEGIN
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'queue_worker') THEN
        CREATE ROLE queue_worker LOGIN;
    END IF;
END $$;
\getenv queue_pw QUEUE_PASSWORD
ALTER ROLE queue_worker PASSWORD :'queue_pw';
SQL