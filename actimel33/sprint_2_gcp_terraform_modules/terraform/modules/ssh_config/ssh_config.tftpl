Host ${bastion_name}
    HostName ${bastion_name}
    User ${user}
    IdentityFile ~/.ssh/google_compute_engine
    ProxyCommand gcloud compute start-iap-tunnel ${bastion_name} 22 --listen-on-stdin --project=${project} --zone=${zone}
%{ for name, ip in hosts ~}

Host ${name}
    HostName ${ip}
    User ${user}
    IdentityFile ~/.ssh/google_compute_engine
    ProxyJump ${bastion_name}
%{ endfor ~}
