cat > /usr/local/bin/start-ui.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin

gcloud auth print-access-token | docker login -u oauth2accesstoken --password-stdin https://${registry_host}
docker pull ${image}
docker rm -f crypto_ui >/dev/null 2>&1 || true
exec docker run --rm --name crypto_ui \
  -e HISTORY_URL=http://${hosts.history}:3001 \
  -p ${port}:8080 \
  ${image}
SCRIPT
chmod 755 /usr/local/bin/start-ui.sh

cat > /etc/systemd/system/crypto-ui.service <<'UNIT'
[Unit]
Description=crypto ui container
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
ExecStart=/usr/local/bin/start-ui.sh
ExecStop=/usr/bin/docker stop -t 30 crypto_ui
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now crypto-ui.service
