cat > /usr/local/bin/start-history.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin

umask 077
mkdir -p /run/crypto
APP_PASSWORD=$(gcloud secrets versions access latest --secret=crypto-db-app-password --project=${project_id})
SESSION_SECRET=$(gcloud secrets versions access latest --secret=crypto-session-secret --project=${project_id})
%{ if backend == "redis" ~}
REDIS_PASSWORD=$(gcloud secrets versions access latest --secret=crypto-redis-password --project=${project_id})
%{ endif ~}
cat > /run/crypto/history.env <<EOF
BACKEND=${backend}
HISTORY_HOST=0.0.0.0
DATABASE_URL=postgres://app:$APP_PASSWORD@${hosts.db}:5432/crypto
SESSION_SECRET=$SESSION_SECRET
%{ if backend == "redis" ~}
REDIS_URL=redis://${hosts.db}:6379
REDIS_PASSWORD=$REDIS_PASSWORD
%{ endif ~}
EOF

gcloud auth print-access-token | docker login -u oauth2accesstoken --password-stdin https://${registry_host}
docker pull ${image}
docker rm -f crypto_history >/dev/null 2>&1 || true
exec docker run --rm --name crypto_history --hostname history --read-only --init --env-file /run/crypto/history.env -p 3001:3001 ${image}
SCRIPT
chmod 755 /usr/local/bin/start-history.sh

cat > /etc/systemd/system/crypto-history.service <<'UNIT'
[Unit]
Description=crypto history container
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
ExecStart=/usr/local/bin/start-history.sh
ExecStop=/usr/bin/docker stop -t 30 crypto_history
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now crypto-history.service
