# Generated by Terraform from terraform/outputs.tf. Do not edit by hand: the next apply overwrites it.

[management]
bastion private_ip=${vms["bastion"].private_ip}

[private]
fetcher private_ip=${vms["fetcher"].private_ip}
history private_ip=${vms["history"].private_ip}
ui private_ip=${vms["ui"].private_ip}

%{ if backend == "redis" ~}
broker private_ip=${vms["broker"].private_ip}
%{ endif ~}
%{ if database_type == "vm" ~}
db private_ip=${vms["db"].private_ip}
%{ endif ~}

[all:vars]
ansible_python_interpreter=/usr/bin/python3
project_id=${project_id}
backend=${backend}
database=${database_type}
db_host=${database.host}
db_name=${database.name}
db_user=${database.user}
db_password_secret=${database.password_secret}
repository_id=${repository_id}
history_image_tag=${history_image_tag}
fetcher_image_tag=${fetcher_image_tag}
ui_image_tag=${ui_image_tag}
ui_port=${vms["ui"].port}
registry_host=${region}-docker.pkg.dev
hosts_history=history.${vms["history"].zone}.c.${project_id}.internal
%{ if backend == "redis" ~}
hosts_broker=broker.${vms["broker"].zone}.c.${project_id}.internal
%{ endif ~}
%{ if database_type == "vm" ~}
db_disk=${db_disk}
%{ endif ~}
