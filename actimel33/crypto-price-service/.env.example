# Local development (./dev.sh) only; the VMs get their settings from the Vagrantfile.
# Copy to .env and fill in real values. .env never reaches the repository.

POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=crypto
DATABASE_URL=postgres://app:change_me_locally@localhost:5432/crypto

SESSION_SECRET=change_me_session

# Where the queue and the sessions live: redis | postgres (pgmq + session table)
BACKEND=redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=change_me_redis
# postgres only, the fetcher's login; locally the app owner will do.
QUEUE_DATABASE_URL=postgres://app:change_me_locally@localhost:5432/crypto

# Defaults live in the code; uncomment to override.
# HISTORY_PORT=3001
# FETCHER_PORT=3002
# CACHE_TTL_SECONDS=900
# BOOTSTRAP_DAYS=7
# DEFAULT_COIN=bitcoin
# DEFAULT_VS=usd
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# TIMER_INTERVAL_HOURS=12
# HTTP_TIMEOUT_MS=10000
# RETRY_ATTEMPTS=3
