# One machine per role, each reachable on the LAN at its own address.
# Redis (BACKEND=redis) shares the database node: the task asks not to spend a
# separate VM on infrastructure services.
#
#   vagrant up                     all machines
#   vagrant up history             just one of them
#   vagrant destroy -f && vagrant up    the honest reproducibility check
#
# Provider is libvirt/KVM inside WSL rather than VirtualBox on Windows:

require "fileutils"
require "securerandom"

ENV["VAGRANT_DEFAULT_PROVIDER"] ||= "libvirt"

PROJECT_DIR = File.expand_path(__dir__).freeze

NET = "192.168.77".freeze

MACHINES = [
  { name: "db",      ip: "#{NET}.10", port: 5432, cpus: 2, memory: 2048 },
  { name: "fetcher", ip: "#{NET}.11", port: 3002, cpus: 2, memory: 2048 },
  { name: "history", ip: "#{NET}.12", port: 3001, cpus: 2, memory: 2048 },
  { name: "ui",      ip: "#{NET}.13", port: 5173, cpus: 2, memory: 2048 },
].freeze

ADDRESS = MACHINES.to_h { |m| [m[:name], m[:ip]] }.freeze

# Secrets are generated once, kept outside git; each machine gets only its own.
SECRETS_FILE = File.join(PROJECT_DIR, ".vagrant", "secrets.env").freeze

SECRET_GENERATORS = {
  "POSTGRES_PASSWORD" => -> { SecureRandom.hex(16) },
  "REDIS_PASSWORD" => -> { SecureRandom.hex(16) },
  "SESSION_SECRET" => -> { SecureRandom.hex(32) },
  "QUEUE_WORKER_PASSWORD" => -> { SecureRandom.hex(16) },
}.freeze

# Keeps existing values; generates only the keys that are missing.
def load_secrets(path)
  stored = File.exist?(path) ? File.readlines(path).each_with_object({}) do |line, acc|
    key, value = line.strip.split("=", 2)
    acc[key] = value if key && value
  end : {}
  missing = SECRET_GENERATORS.reject { |key, _| stored.key?(key) }
  return stored if missing.empty?

  secrets = stored.merge(missing.transform_values(&:call))
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, secrets.map { |k, v| "#{k}=#{v}" }.join("\n") + "\n", perm: 0o600)
  File.chmod(0o600, path)
  secrets
end

SECRETS = load_secrets(SECRETS_FILE)

# `ssh db` from the host
SSH_CONFIG = File.join(PROJECT_DIR, ".vagrant", "ssh", "config").freeze

def write_ssh_config(path)
  hosts = MACHINES.map do |m|
    key = File.join(PROJECT_DIR, ".vagrant", "machines", m[:name], "libvirt", "private_key")
    "Host #{m[:name]}\n  HostName #{m[:ip]}\n  IdentityFile \"#{key}\"\n"
  end
  common = <<~SSH
    Host #{MACHINES.map { |m| m[:name] }.join(" ")}
      User vagrant
      IdentitiesOnly yes
      StrictHostKeyChecking no
      UserKnownHostsFile /dev/null
      LogLevel ERROR
  SSH
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, ["# Generated by the Vagrantfile, do not edit.\n", *hosts, common].join("\n"))
end

write_ssh_config(SSH_CONFIG)

# Log shipping: one key per machine, generated once, outside git.
LOGSHIP_DIR = File.join(PROJECT_DIR, ".vagrant", "logship").freeze

def logship_key(name)
  path = File.join(LOGSHIP_DIR, name)
  unless File.exist?(path)
    FileUtils.mkdir_p(LOGSHIP_DIR)
    ok = system("ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "logship@#{name}", "-f", path)
    abort("ssh-keygen failed for #{name}") unless ok
  end
  path
end

# Each key: no shell or forwarding, only from its own address,
# only appends to /srv/logs/<name>/ on the collector.
def write_logship_authorized_keys
  lines = MACHINES.map do |m|
    pub = File.read("#{logship_key(m[:name])}.pub").strip
    %(restrict,from="#{m[:ip]}",command="/usr/local/bin/logsink #{m[:name]}" #{pub})
  end
  path = File.join(LOGSHIP_DIR, "authorized_keys")
  File.write(path, lines.join("\n") + "\n")
  path
end

LOGSHIP_AUTHORIZED_KEYS = write_logship_authorized_keys

# No synced folder: the project lives in the WSL filesystem and the code travels
# to the machine as an archive over ssh.
PAYLOAD = File.join(PROJECT_DIR, ".vagrant", "payload.tgz").freeze

# Packing happens while the config is read, not in a trigger: Vagrant checks
# that the file provisioner's source exists before any trigger can run.
packed = system(
  "tar", "-C", PROJECT_DIR,
  "--exclude=./.vagrant", "--exclude=./.env", "--exclude=./logs", "--exclude=./bin",
  "--exclude=./ui/dist", "--exclude=./ui/node_modules", "--exclude=./services/history/node_modules",
  "-czf", PAYLOAD, "."
)
abort("failed to pack the project into #{PAYLOAD}") unless packed

# Replaces the code: files deleted from the repo must not linger on the VM.
UNPACK = <<~SHELL
  set -eu
  rm -rf /home/vagrant/app
  mkdir -p /home/vagrant/app
  tar xzf /tmp/app.tgz -C /home/vagrant/app
  chown -R vagrant:vagrant /home/vagrant/app
SHELL

LOGSHIP_COLLECTOR = "logs@#{ADDRESS.fetch("db")}".freeze

# Where the queue and the sessions live. Remembered between runs, so a later
# `vagrant provision history` does not quietly switch one service back:
#   BACKEND=postgres vagrant provision db fetcher history
BACKEND_FILE = File.join(PROJECT_DIR, ".vagrant", "backend").freeze
BACKEND = (ENV["BACKEND"] || (File.read(BACKEND_FILE).strip if File.exist?(BACKEND_FILE)) || "redis").freeze
abort("BACKEND must be redis or postgres, got #{BACKEND}") unless %w[redis postgres].include?(BACKEND)
File.write(BACKEND_FILE, BACKEND)

DB_IP = ADDRESS.fetch("db")
POSTGRES = { "POSTGRES_USER" => "app", "POSTGRES_DB" => "crypto" }.freeze
DATABASE_URL = "postgres://app:#{SECRETS.fetch("POSTGRES_PASSWORD")}@#{DB_IP}:5432/crypto".freeze
QUEUE_DATABASE_URL = "postgres://queue_worker:#{SECRETS.fetch("QUEUE_WORKER_PASSWORD")}@#{DB_IP}:5432/crypto".freeze
REDIS = { "REDIS_URL" => "redis://#{DB_IP}:6379", "REDIS_PASSWORD" => SECRETS.fetch("REDIS_PASSWORD") }.freeze

# Each role script gets what its containers need and nothing else: the fetcher
# never sees the app owner's password, the ui no secret at all.
ROLE_ENV = {
  "db" => POSTGRES.merge(SECRETS.slice("POSTGRES_PASSWORD", "REDIS_PASSWORD", "QUEUE_WORKER_PASSWORD")),
  "fetcher" => BACKEND == "postgres" ? { "QUEUE_DATABASE_URL" => QUEUE_DATABASE_URL } : REDIS,
  "history" => { "DATABASE_URL" => DATABASE_URL, "SESSION_SECRET" => SECRETS.fetch("SESSION_SECRET") }
                 .merge(BACKEND == "redis" ? REDIS : {}),
  "ui" => {},
}.transform_values do |env|
  env.merge("BACKEND" => BACKEND, "DB_IP" => DB_IP, "HISTORY_IP" => ADDRESS.fetch("history")).freeze
end.freeze

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.boot_timeout = 600
  config.vm.synced_folder ".", "/vagrant", disabled: true

  MACHINES.each do |spec|
    config.vm.define spec[:name] do |machine|
      machine.vm.hostname = spec[:name]
      # Only a LAN address
      machine.vm.network "private_network", ip: spec[:ip]

      machine.vm.provider :libvirt do |lv|
        lv.cpus = spec[:cpus]
        lv.memory = spec[:memory]
        lv.driver = "kvm"
      end

      machine.vm.provision "code", type: "file", source: PAYLOAD, destination: "/tmp/app.tgz"
      machine.vm.provision "unpack", type: "shell", inline: UNPACK
      machine.vm.provision "system", type: "shell", path: "vagrant/provision-system.sh"
      machine.vm.provision "role", type: "shell", privileged: false,
                           path: "vagrant/provision-#{spec[:name]}.sh",
                           env: ROLE_ENV.fetch(spec[:name])

      if spec[:name] == "db"
        machine.vm.provision "collector-keys", type: "file",
                             source: LOGSHIP_AUTHORIZED_KEYS,
                             destination: "/tmp/logship_authorized_keys"
        machine.vm.provision "collector", type: "shell",
                             path: "vagrant/provision-collector.sh"
      end

      machine.vm.provision "logship-key", type: "file",
                           source: logship_key(spec[:name]),
                           destination: "/tmp/logship_key"
      machine.vm.provision "logship", type: "shell",
                           path: "vagrant/provision-logship.sh",
                           env: { "LOGSHIP_COLLECTOR" => LOGSHIP_COLLECTOR }
    end
  end

  config.vm.post_up_message = [
    "Each service runs on its own machine, reachable on the LAN:",
    "",
    *MACHINES.map { |m| "  #{m[:name].ljust(8)} http://#{m[:ip]}:#{m[:port]}" },
    "",
    "  backend           #{BACKEND}   (switch: BACKEND=postgres vagrant provision db fetcher history)",
    *(BACKEND == "redis" ? ["  redis             #{DB_IP}:6379 on the db node"] : []),
    "",
    "  open the app      http://#{ADDRESS.fetch("ui")}:5173",
    "  check history     curl http://#{ADDRESS.fetch("history")}:3001/health",
    "  check fetcher     curl http://#{ADDRESS.fetch("fetcher")}:3002/health",
    "",
    "  ssh by name       add to the top of ~/.ssh/config:  Include #{SSH_CONFIG}",
    "  logs              ssh db sudo ls /srv/logs   (shipped every 15 min)",
  ].join("\n")
end
