#!/usr/bin/env bash
# Startup script of the ${role} VM
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# Runs on every boot; the work is done once.
MARKER=/var/lib/crypto/provisioned
if [ -f "$MARKER" ]; then
  echo "already provisioned"
  exit 0
fi

# Access token of this VM's service account, from the metadata server.
token() {
  curl -sf -H 'Metadata-Flavor: Google' \
    http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["access_token"])'
}

# One secret from Secret Manager.
secret() {
  local name=$1 auth
  for _ in $(seq 1 30); do
    if auth=$(token) &&
       curl -sf -H "Authorization: Bearer $auth" \
         "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/crypto-$name/versions/latest:access" |
         python3 -c 'import base64,json,sys; sys.stdout.write(base64.b64decode(json.load(sys.stdin)["payload"]["data"]).decode())'
    then
      return 0
    fi
    sleep 10
  done
  echo "secret $name is not readable" >&2
  return 1
}

# NAME=value lines into a 0600 file for docker --env-file: no secret on a command line.
env_file() {
  local file=$1
  shift
  (umask 077 && printf '%s\n' "$@" > "$file")
}

# Dependencies come up in parallel: wait up to 10 minutes for host:port.
wait_port() {
  for _ in $(seq 1 300); do
    timeout 2 bash -c "echo > /dev/tcp/$1/$2" 2>/dev/null && return 0
    sleep 2
  done
  echo "$1:$2 unreachable" >&2
  return 1
}

run_container() {
  local name=$1
  shift
  docker rm -f "$name" >/dev/null 2>&1 || true
  docker run -d --name "$name" --restart unless-stopped "$@"
}

wait_healthy() {
  for _ in $(seq 1 90); do
    [ "$(docker inspect -f '{{.State.Health.Status}}' "$1" 2>/dev/null)" = healthy ] && return 0
    sleep 2
  done
  docker logs --tail 30 "$1" >&2
  return 1
}

# Docker from its signed apt repository; local logs capped, the central copy is on db.
install_docker() {
  apt_get() { apt-get -o DPkg::Lock::Timeout=300 -qq "$@"; }
  apt_get update
  apt_get install -y ca-certificates curl >/dev/null
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    > /etc/apt/sources.list.d/docker.list
  apt_get update
  apt_get install -y docker-ce docker-ce-cli containerd.io >/dev/null
  echo '{"log-driver":"json-file","log-opts":{"max-size":"10m","max-file":"3"}}' > /etc/docker/daemon.json
  systemctl restart docker
}

# Pull access to Artifact Registry with the VM's own account (reader on the repository only).
registry_login() {
  for _ in $(seq 1 30); do
    token | docker login -u oauth2accesstoken --password-stdin "https://${split("/", registry)[0]}" >/dev/null &&
      docker pull -q "$1" >/dev/null && return 0
    sleep 10
  done
  echo "cannot pull $1" >&2
  return 1
}

# Container logs go to the collector on db every 15 minutes.
setup_logship() {
  install -d -m 0700 /etc/logship /var/spool/logship
  (umask 077 && secret "logship-key-${role}" > /etc/logship/id_ed25519)
  cat > /usr/local/bin/logship <<'LOGSHIP_EOF'
${logship_script}
LOGSHIP_EOF
  chmod 0755 /usr/local/bin/logship
  echo "LOGSHIP_COLLECTOR=logs@${ip.db}" > /etc/logship/logship.conf
  echo '*/15 * * * * root /usr/local/bin/logship 2>&1 | logger -t logship' > /etc/cron.d/logship
}

# Keys only; AllowUsers decides who may log in, and from where.
guard_ssh() {
  printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\nLogLevel VERBOSE\nAllowUsers %s\n' "$1" \
    > /etc/ssh/sshd_config.d/10-crypto.conf
  sshd -t
  systemctl try-reload-or-restart ssh
}

done_provisioning() {
  install -d /var/lib/crypto
  touch "$MARKER"
  echo "provisioned"
}

install -d -m 0755 /opt/crypto