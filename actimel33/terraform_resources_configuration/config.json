{
    "$schema": "./config.schema.json",
    "project": {
        "id": "crypto-price-0e590f",
        "region": "europe-central2",
        "labels": {
            "env": "dev",
            "managed_by": "terraform"
        }
    },
    "bootstrap": {
        "project_id_prefix": "crypto-price",
        "project_name": "crypto-price-service",
        "terraform_service_account": "terraform",
        "state_prefix": "terraform/state",
        "cloudflare_token_secret": "cloudflare-api-token",
        "apis": [
            "cloudresourcemanager.googleapis.com",
            "serviceusage.googleapis.com",
            "iam.googleapis.com",
            "iamcredentials.googleapis.com",
            "storage.googleapis.com",
            "compute.googleapis.com",
            "iap.googleapis.com",
            "secretmanager.googleapis.com",
            "artifactregistry.googleapis.com",
            "oslogin.googleapis.com"
        ],
        "terraform_roles": [
            "roles/compute.admin",
            "roles/iam.serviceAccountAdmin",
            "roles/iam.serviceAccountUser",
            "roles/secretmanager.admin",
            "roles/artifactregistry.admin"
        ]
    },
    "app": {
        "backend": "postgres"
    },
    "network": {
        "vpc": "crypto-vpc",
        "subnets": {
            "private": {
                "name": "crypto-private",
                "cidr": "192.168.77.0/24"
            },
            "management": {
                "name": "crypto-management",
                "cidr": "192.168.78.0/24"
            }
        },
        "nat_router": "nat-router"
    },
    "firewall": {
        "common": {
            "fw-allow-iap-to-bastion": {
                "protocol": "tcp",
                "ports": [
                    "22"
                ],
                "source_ranges": [
                    "35.235.240.0/20"
                ],
                "target_tags": [
                    "bastion-vm"
                ]
            },
            "fw-allow-bastion-to-internal": {
                "protocol": "tcp",
                "ports": [
                    "22"
                ],
                "source_tags": [
                    "bastion-vm"
                ],
                "target_tags": [
                    "internal-vm"
                ]
            },
            "fw-allow-lb-to-ui": {
                "protocol": "tcp",
                "ports": [
                    "5173"
                ],
                "source_ranges": [
                    "130.211.0.0/22",
                    "35.191.0.0/16"
                ],
                "target_tags": [
                    "ui-vm"
                ]
            },
            "fw-allow-history-to-db": {
                "protocol": "tcp",
                "ports": [
                    "5432"
                ],
                "source_tags": [
                    "history-vm"
                ],
                "target_tags": [
                    "db-vm"
                ]
            },
            "fw-allow-ui-to-history": {
                "protocol": "tcp",
                "ports": [
                    "3001"
                ],
                "source_tags": [
                    "ui-vm"
                ],
                "target_tags": [
                    "history-vm"
                ]
            }
        },
        "postgres": {
            "fw-allow-fetcher-to-db": {
                "protocol": "tcp",
                "ports": [
                    "5432"
                ],
                "source_tags": [
                    "fetcher-vm"
                ],
                "target_tags": [
                    "db-vm"
                ]
            }
        },
        "redis": {
            "fw-allow-app-to-redis": {
                "protocol": "tcp",
                "ports": [
                    "6379"
                ],
                "source_tags": [
                    "fetcher-vm",
                    "history-vm"
                ],
                "target_tags": [
                    "db-vm"
                ]
            }
        }
    },
    "vms": {
        "service_account_prefix": "sa-vm-",
        "defaults": {
            "type": "e2-small",
            "zone": "europe-central2-a",
            "image": "ubuntu-os-cloud/ubuntu-2404-lts-amd64",
            "disk_size": 10,
            "disk_type": "pd-balanced",
            "subnet": "private"
        },
        "machines": {
            "bastion": {
                "type": "e2-micro",
                "subnet": "management"
            },
            "db": {
                "image_tag": "1.0.0",
                "data_disk": {
                    "name": "crypto-db-data-disk",
                    "size": 10,
                    "type": "pd-standard",
                    "device_name": "data-disk"
                }
            },
            "fetcher": {
                "image_tag": "1.0.0"
            },
            "history": {
                "image_tag": "1.0.0"
            },
            "ui": {
                "image_tag": "1.0.0",
                "port": 5173
            }
        }
    },
    "secrets": {
        "crypto-db-app-password": {
            "length": 16,
            "readers": [
                "db",
                "history"
            ],
            "version": 1
        },
        "crypto-db-queue-worker-password": {
            "length": 16,
            "readers": [
                "db",
                "fetcher"
            ],
            "version": 1
        },
        "crypto-redis-password": {
            "length": 16,
            "readers": [
                "db",
                "history",
                "fetcher"
            ],
            "version": 1
        },
        "crypto-session-secret": {
            "length": 32,
            "readers": [
                "history"
            ],
            "version": 1
        }
    },
    "registry": {
        "repository_id": "crypto-services-repository",
        "format": "DOCKER",
        "description": "Docker repository for crypto application images"
    },
    "load_balancer": {
        "name": "crypto-ui",
        "backend": "ui",
        "health_check_path": "/",
        "domain": "crypto.ai-optimizer.net"
    },
    "dns": {
        "cloudflare_zone_id": "6eb0f4498c576e43d1731bfdfd82825e"
    },
    "ssh": {
        "bastion": "bastion"
    }
}
