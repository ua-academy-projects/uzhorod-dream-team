{
    "env": "dev",
    "project_id": "crypto-price-2610",
    "region": "europe-central2",
    "ssh_user": "proshina_playground",
    "bastion_name": "bastion",
    "firewalls": {
        "fw-allow-iap-to-bastion": {
            "ports": [
                "22"
            ],
            "source_ranges": [
                "35.235.240.0/20"
            ],
            "target_tags": [
                "bastion-vm"
            ]
        },
        "fw-allow-bastion-to-internal": {
            "ports": [
                "22"
            ],
            "source_tags": [
                "bastion-vm"
            ],
            "target_tags": [
                "internal-vm"
            ]
        },
        "fw-allow-lb-to-ui": {
            "ports": [
                "5173"
            ],
            "source_ranges": [
                "130.211.0.0/22",
                "35.191.0.0/16"
            ],
            "target_tags": [
                "ui-vm"
            ]
        }
    },
    "networks": {
        "secure_vpc": "private-network",
        "private_network": "crypto-private",
        "edge_network": "crypto-edge",
        "private_cidr": "192.168.77.0/24",
        "edge_cidr": "192.168.78.0/24",
        "nat_router_name": "nat-router",
        "private_subnet_region": "europe-central2",
        "edge_subnet_region": "europe-central2",
        "nat_router_region": "europe-central2"
    },
    "machines": {
        "bastion": {
            "disc_size": 10,
            "disc_type": "pd-balanced",
            "type": "e2-micro",
            "has_edge": true,
            "zone": "europe-central2-a",
            "image": "ubuntu-os-cloud/ubuntu-2404-lts-amd64",
            "tags": [
                "bastion-vm"
            ]
        },
        "db": {
            "disc_type": "pd-balanced",
            "disc_size": 10,
            "image": "ubuntu-os-cloud/ubuntu-2404-lts-amd64",
            "type": "e2-small",
            "has_edge": false,
            "zone": "europe-central2-a",
            "data_disk": {
                "name": "crypto-db-data-disk",
                "size": 10,
                "type": "pd-standard",
                "device_name": "data-disk"
            },
            "tags": [
                "internal-vm"
            ]
        },
        "fetcher": {
            "disc_type": "pd-balanced",
            "disc_size": 10,
            "image": "ubuntu-os-cloud/ubuntu-2404-lts-amd64",
            "type": "e2-small",
            "has_edge": false,
            "zone": "europe-central2-a",
            "tags": [
                "internal-vm"
            ]
        },
        "history": {
            "disc_type": "pd-balanced",
            "disc_size": 10,
            "image": "ubuntu-os-cloud/ubuntu-2404-lts-amd64",
            "type": "e2-small",
            "has_edge": false,
            "zone": "europe-central2-a",
            "tags": [
                "internal-vm"
            ]
        },
        "ui": {
            "disc_type": "pd-balanced",
            "image": "ubuntu-os-cloud/ubuntu-2404-lts-amd64",
            "disc_size": 10,
            "type": "e2-small",
            "has_edge": false,
            "zone": "europe-central2-a",
            "tags": [
                "internal-vm",
                "ui-vm"
            ]
        }
    },
    "iam": {
        "service_account_prefix": "sa-vm-"
    },
    "secrets": {
        "crypto-db-password": {
            "length": 16,
            "readers": [
                "db",
                "fetcher"
            ],
            "version": 1
        }
    },
    "artifact_registry": {
        "repository_id": "crypto-services-repository",
        "format": "DOCKER",
        "description": "Docker repository for crypto application images",
        "readers": [
            "db",
            "fetcher",
            "history",
            "ui"
        ]
    },
    "load_balancer": {
        "name": "crypto-ui",
        "backend": "ui",
        "port": 5173,
        "health_check_path": "/",
        "domain": "crypto.ai-optimizer.net"
    },
    "dns": {
        "cloudflare_zone_id": "6eb0f4498c576e43d1731bfdfd82825e"
    },
    "google_project_services_list": [
        "artifactregistry.googleapis.com",
        "cloudbuild.googleapis.com",
        "compute.googleapis.com",
        "iam.googleapis.com",
        "iap.googleapis.com",
        "secretmanager.googleapis.com",
        "storage.googleapis.com"
    ]
}
