{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "crypto-price-service configuration",
    "description": "Read by Terraform (each module gets its own part), bootstrap/bootstrap.sh and build-and-push.sh.",
    "type": "object",
    "required": ["project", "bootstrap", "app", "network", "firewall", "vms", "secrets", "cloud_sql", "registry", "load_balancer", "dns", "ssh"],
    "additionalProperties": false,
    "properties": {
        "$schema": { "type": "string" },
        "project": {
            "description": "GCP project used by every part.",
            "type": "object",
            "required": ["id", "region", "labels"],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "description": "Project ID. Empty: bootstrap.sh creates a new project and writes its ID here.",
                    "type": "string",
                    "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9])?$"
                },
                "region": { "description": "Region of all resources, e.g. europe-central2.", "type": "string", "pattern": "^[a-z]+-[a-z]+[0-9]+$" },
                "labels": { "description": "Labels put on every resource that supports them.", "type": "object", "additionalProperties": { "type": "string" } }
            }
        },
        "bootstrap": {
            "description": "Read only by bootstrap/bootstrap.sh.",
            "type": "object",
            "required": ["project_id_prefix", "project_name", "terraform_service_account", "state_prefix", "cloudflare_token_secret", "apis", "terraform_roles"],
            "additionalProperties": false,
            "properties": {
                "project_id_prefix": { "description": "A new project gets the ID <prefix>-<6 random hex characters>.", "type": "string", "pattern": "^[a-z][a-z0-9-]{0,22}$" },
                "project_name": { "description": "Display name of a new project.", "type": "string", "minLength": 4, "maxLength": 30 },
                "terraform_service_account": { "description": "ID of the service account Terraform runs as.", "type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$" },
                "state_prefix": { "description": "Folder of the Terraform state in the state bucket.", "type": "string", "minLength": 1 },
                "cloudflare_token_secret": { "description": "Secret Manager secret with the Cloudflare API token; terraform/.env reads it.", "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" },
                "apis": {
                    "description": "APIs enabled in the project.",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[a-z0-9-]+\\.googleapis\\.com$" }
                },
                "terraform_roles": {
                    "description": "Project roles of the Terraform service account.",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^roles/[a-zA-Z.]+$" }
                }
            }
        },
        "app": {
            "type": "object",
            "required": ["backend"],
            "additionalProperties": false,
            "properties": {
                "backend": { "description": "Queue backend of the app. Picks the firewall group and the containers on the VMs.", "enum": ["postgres", "redis"] }
            }
        },
        "network": {
            "type": "object",
            "required": ["vpc", "subnets", "nat_router"],
            "additionalProperties": false,
            "properties": {
                "vpc": { "description": "Name of the VPC.", "$ref": "#/definitions/name" },
                "subnets": {
                    "description": "private: VMs without public IPs, internet through Cloud NAT. management: the bastion.",
                    "type": "object",
                    "required": ["private", "management"],
                    "additionalProperties": false,
                    "properties": {
                        "private": { "$ref": "#/definitions/subnet" },
                        "management": { "$ref": "#/definitions/subnet" }
                    }
                },
                "nat_router": { "description": "Name of the Cloud Router; the NAT gets <name>-nat.", "$ref": "#/definitions/name" }
            }
        },
        "firewall": {
            "description": "Rule name => rule. common applies to every backend, postgres and redis only to that backend.",
            "type": "object",
            "required": ["common", "postgres", "redis"],
            "additionalProperties": false,
            "properties": {
                "common": { "$ref": "#/definitions/firewall_rules" },
                "postgres": { "$ref": "#/definitions/firewall_rules" },
                "redis": { "$ref": "#/definitions/firewall_rules" }
            }
        },
        "vms": {
            "type": "object",
            "required": ["service_account_prefix", "defaults", "machines"],
            "additionalProperties": false,
            "properties": {
                "service_account_prefix": { "description": "Each VM gets the service account <prefix><VM name>.", "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "defaults": {
                    "description": "Values for every VM; a machine lists only what differs.",
                    "allOf": [
                        { "$ref": "#/definitions/machine" },
                        { "required": ["type", "zone", "image", "disk_size", "disk_type", "subnet"] }
                    ]
                },
                "machines": {
                    "description": "VM name => what differs from defaults.",
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": { "$ref": "#/definitions/name" },
                    "additionalProperties": { "$ref": "#/definitions/machine" }
                }
            }
        },
        "secrets": {
            "description": "Secret ID => generated password.",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": ["length", "readers", "version"],
                "additionalProperties": false,
                "properties": {
                    "length": { "description": "Password length.", "type": "integer", "minimum": 16 },
                    "readers": { "description": "VMs whose service accounts may read the secret.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
                    "version": { "description": "Raise by one to generate and store a new password.", "type": "integer", "minimum": 1 }
                }
            }
        },
        "cloud_sql": {
            "description": "Postgres of the app in Cloud SQL, reachable only through a Private Service Connect endpoint.",
            "type": "object",
            "required": ["name", "database_version", "edition", "tier", "availability_type", "disk_size", "disk_type", "deletion_protection", "database", "user", "password_secret", "endpoint"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "description": "Instance name. Terraform adds -<4 hex characters>: a deleted name stays taken for about a week.",
                    "allOf": [{ "$ref": "#/definitions/name" }, { "maxLength": 58 }]
                },
                "database_version": { "description": "e.g. POSTGRES_17.", "type": "string", "pattern": "^POSTGRES_[0-9]+$" },
                "edition": { "enum": ["ENTERPRISE", "ENTERPRISE_PLUS"] },
                "tier": { "description": "Machine tier, e.g. db-f1-micro.", "type": "string", "pattern": "^db-[a-z0-9-]+$" },
                "availability_type": { "description": "ZONAL: one zone. REGIONAL: a standby in a second zone (HA).", "enum": ["ZONAL", "REGIONAL"] },
                "disk_size": { "description": "Disk size in GB.", "type": "integer", "minimum": 10 },
                "disk_type": { "enum": ["PD_SSD", "PD_HDD"] },
                "deletion_protection": { "description": "true blocks terraform destroy of the instance.", "type": "boolean" },
                "database": { "description": "Database of the app.", "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "user": { "description": "Database user of the app, created by Terraform.", "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "password_secret": { "description": "Secret in the secrets part with the password of user.", "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
                "endpoint": { "description": "Name of the endpoint address and its forwarding rule.", "$ref": "#/definitions/name" }
            }
        },
        "registry": {
            "type": "object",
            "required": ["repository_id", "format", "description"],
            "additionalProperties": false,
            "properties": {
                "repository_id": { "description": "Artifact Registry repository for the app images.", "$ref": "#/definitions/name" },
                "format": { "enum": ["DOCKER"] },
                "description": { "type": "string" }
            }
        },
        "load_balancer": {
            "type": "object",
            "required": ["name", "backend", "health_check_path", "domain"],
            "additionalProperties": false,
            "properties": {
                "name": { "description": "Prefix of the load balancer resource names.", "$ref": "#/definitions/name" },
                "backend": { "description": "VM behind the load balancer; it needs a port in vms.machines.", "type": "string" },
                "health_check_path": { "type": "string", "pattern": "^/" },
                "domain": { "description": "Domain of the site and its Google-managed certificate.", "type": "string", "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$" }
            }
        },
        "dns": {
            "type": "object",
            "required": ["cloudflare_zone_id"],
            "additionalProperties": false,
            "properties": {
                "cloudflare_zone_id": { "description": "Cloudflare zone of the domain. The API token comes from CLOUDFLARE_API_TOKEN.", "type": "string", "pattern": "^[0-9a-f]{32}$" }
            }
        },
        "ssh": {
            "description": "Read by ssh-config.sh; the user name comes from the OS Login profile of whoever runs it.",
            "type": "object",
            "required": ["bastion"],
            "additionalProperties": false,
            "properties": {
                "bastion": { "description": "VM that the SSH config jumps through.", "type": "string" }
            }
        }
    },
    "definitions": {
        "name": { "description": "GCP resource name.", "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$" },
        "cidr": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" },
        "subnet": {
            "type": "object",
            "required": ["name", "cidr"],
            "additionalProperties": false,
            "properties": {
                "name": { "$ref": "#/definitions/name" },
                "cidr": { "$ref": "#/definitions/cidr" }
            }
        },
        "firewall_rules": {
            "type": "object",
            "propertyNames": { "$ref": "#/definitions/name" },
            "additionalProperties": {
                "type": "object",
                "required": ["protocol", "ports", "target_tags"],
                "anyOf": [{ "required": ["source_ranges"] }, { "required": ["source_tags"] }],
                "additionalProperties": false,
                "properties": {
                    "protocol": { "enum": ["tcp", "udp"] },
                    "ports": { "description": "Ports or ranges as strings, e.g. \"22\" or \"8000-8080\".", "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" } },
                    "source_ranges": {
                        "description": "Allowed source IP ranges; never 0.0.0.0/0.",
                        "type": "array",
                        "minItems": 1,
                        "items": { "$ref": "#/definitions/cidr" },
                        "not": { "contains": { "const": "0.0.0.0/0" } }
                    },
                    "source_tags": { "description": "Allowed source VMs by network tag (<vm>-vm).", "type": "array", "minItems": 1, "items": { "type": "string" } },
                    "target_tags": { "description": "VMs the rule applies to, by network tag (<vm>-vm or internal-vm).", "type": "array", "minItems": 1, "items": { "type": "string" } }
                }
            }
        },
        "machine": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": { "description": "Machine type, e.g. e2-small.", "type": "string" },
                "zone": { "description": "Zone, e.g. europe-central2-a.", "type": "string", "pattern": "^[a-z]+-[a-z]+[0-9]+-[a-z]$" },
                "image": { "description": "Boot image, e.g. ubuntu-os-cloud/ubuntu-2404-lts-amd64.", "type": "string" },
                "disk_size": { "description": "Boot disk size in GB.", "type": "integer", "minimum": 10 },
                "disk_type": { "$ref": "#/definitions/disk_type" },
                "subnet": { "enum": ["private", "management"] },
                "image_tag": { "description": "Tag of the app image; the VM runs its container. Changing it recreates the VM.", "type": "string" },
                "port": { "description": "Port the container listens on, for the load balancer.", "type": "integer", "minimum": 1, "maximum": 65535 },
                "backends": {
                    "description": "Backends this VM is created for; without it the VM always exists.",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "enum": ["postgres", "redis"] }
                },
                "data_disk": {
                    "description": "Separate disk that keeps data when the VM is recreated.",
                    "type": "object",
                    "required": ["name", "size", "type", "device_name"],
                    "additionalProperties": false,
                    "properties": {
                        "name": { "$ref": "#/definitions/name" },
                        "size": { "description": "Size in GB.", "type": "integer", "minimum": 10 },
                        "type": { "$ref": "#/definitions/disk_type" },
                        "device_name": { "description": "Disk appears in the VM as /dev/disk/by-id/google-<device_name>.", "$ref": "#/definitions/name" }
                    }
                }
            }
        },
        "disk_type": { "enum": ["pd-standard", "pd-balanced", "pd-ssd"] }
    }
}
