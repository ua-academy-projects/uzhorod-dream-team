server_tokens off;

set_real_ip_from 127.0.0.1;
real_ip_header CF-Connecting-IP;

limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=collect:10m rate=10r/m;
limit_req_status 429;

server {
    listen 80 default_server;
    server_name _;
    return 308 https://{{ container_domain }}$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name {{ container_domain }};
    ssl_certificate /etc/letsencrypt/live/{{ container_cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ container_cert_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /usr/share/nginx/html;
    index index.html;
    add_header Cache-Control "no-store" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    location / { try_files $uri $uri/ =404; }
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://{{ container_history_ip }}:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /api/collect {
        limit_req zone=collect burst=5 nodelay;
        proxy_pass http://{{ container_history_ip }}:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
