WEATHER_BACKEND={{ app.backend }}
FETCHER_HOST=127.0.0.1
{% if app.backend == 'rabbitmq_redis' %}
RABBITMQ_URL=amqp://weather:{{ container_rabbitmq_password | urlencode }}@{{ container_rabbitmq_ip }}:5672/weather
{% else %}
DATABASE_URL=postgresql://weather_fetcher:{{ container_fetcher_password | urlencode }}@{{ container_db_ip }}:5432/{{ app.database_name }}?sslmode={{ 'disable' if app.database == 'vm' else 'require' }}
{% endif %}
