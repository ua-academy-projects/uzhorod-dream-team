WEATHER_BACKEND={{ app.backend }}
DATABASE_URL=postgresql://weather_app:{{ container_app_password | urlencode }}@{{ container_db_ip }}:5432/{{ app.database_name }}?sslmode={{ 'disable' if app.database == 'vm' else 'require' }}
HISTORY_ADDR={{ ansible_host }}:8002
HISTORY_SERVE_UI=false
SESSION_COOKIE_SECURE={{ app.session_cookie_secure | string | lower }}
{% if app.backend == 'rabbitmq_redis' %}
RABBITMQ_URL=amqp://weather:{{ container_rabbitmq_password | urlencode }}@{{ container_rabbitmq_ip }}:5672/weather
REDIS_ADDR={{ container_redis_ip }}:6379
REDIS_PASSWORD={{ container_redis_password }}
{% endif %}
