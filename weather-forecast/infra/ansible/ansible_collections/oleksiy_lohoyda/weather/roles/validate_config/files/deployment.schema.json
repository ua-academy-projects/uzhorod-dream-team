{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weather Forecast deployment config",
  "type": "object",
  "required": ["project", "bootstrap", "networks", "subnets", "firewall", "service_accounts", "secrets", "vms", "app", "ssh"],
  "$defs": {
    "cidr": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" },
    "ip": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$" },
    "names": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
    "rule": {
      "type": "object",
      "required": ["network", "to"],
      "properties": {
        "network": { "type": "string" },
        "from": { "$ref": "#/$defs/names" },
        "to": { "$ref": "#/$defs/names" },
        "protocol": { "type": "string" },
        "ports": { "$ref": "#/$defs/ports" },
        "source_ranges": { "type": "array", "items": { "$ref": "#/$defs/cidr" }, "minItems": 1 }
      }
    },
    "vm": {
      "type": "object",
      "properties": {
        "role": { "enum": ["bastion", "node"] },
        "ip": { "$ref": "#/$defs/ip" },
        "service_account": { "type": "string" },
        "machine_type": { "type": "string" },
        "image": { "type": "string" },
        "boot_disk_gb": { "type": "integer", "minimum": 10 },
        "disk_type": { "type": "string" },
        "subnet": { "type": "string" },
        "public_ip": { "type": "boolean" },
        "disks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["size_gb"],
            "properties": { "size_gb": { "type": "integer", "minimum": 1 }, "type": { "type": "string" } }
          }
        },
        "only_for": {
          "type": "object",
          "properties": {
            "backend": { "enum": ["postgres", "rabbitmq_redis"] },
            "database": { "enum": ["vm", "cloudsql"] }
          },
          "additionalProperties": false
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["host"],
      "properties": {
        "host": { "type": "string" },
        "image": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "prefix", "region", "zone"],
      "properties": {
        "name": { "type": "string" },
        "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "region": { "type": "string" },
        "zone": { "type": "string" }
      }
    },
    "bootstrap": {
      "type": "object",
      "required": ["apis", "terraform_sa", "state"],
      "properties": {
        "apis": { "$ref": "#/$defs/names" },
        "terraform_sa": {
          "type": "object",
          "required": ["name", "roles"],
          "properties": { "name": { "type": "string" }, "roles": { "$ref": "#/$defs/names" } }
        },
        "state": { "type": "object", "required": ["prefix"], "properties": { "prefix": { "type": "string" } } }
      }
    },
    "networks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": { "mtu": { "type": "integer", "minimum": 1300, "maximum": 8896 } }
      }
    },
    "subnets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["network", "cidr"],
        "properties": { "network": { "type": "string" }, "cidr": { "$ref": "#/$defs/cidr" } }
      }
    },
    "firewall": {
      "type": "object",
      "properties": {
        "external": {
          "type": "object",
          "additionalProperties": { "allOf": [{ "$ref": "#/$defs/rule" }, { "required": ["source_ranges"] }] }
        },
        "internal": {
          "type": "object",
          "additionalProperties": { "allOf": [{ "$ref": "#/$defs/rule" }, { "required": ["from"] }] }
        }
      }
    },
    "service_accounts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": { "roles": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["db-password", "cloudflare-api-token"],
      "additionalProperties": {
        "type": "object",
        "properties": { "accessors": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "vms": {
      "type": "object",
      "required": ["instances"],
      "properties": {
        "defaults": { "$ref": "#/$defs/vm" },
        "instances": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "allOf": [{ "$ref": "#/$defs/vm" }, { "required": ["ip", "service_account"] }]
          }
        }
      }
    },
    "cloudsql": {
      "type": "object",
      "required": ["network", "version"],
      "properties": {
        "network": { "type": "string" },
        "version": { "type": "string", "pattern": "^POSTGRES_[0-9]+$" },
        "edition": { "enum": ["ENTERPRISE", "ENTERPRISE_PLUS"] },
        "tier": { "type": "string" },
        "disk_gb": { "type": "integer", "minimum": 10 },
        "peering_prefix_length": { "type": "integer", "minimum": 8, "maximum": 29 },
        "deletion_protection": { "type": "boolean" }
      }
    },
    "app": {
      "type": "object",
      "required": ["backend", "database", "database_name", "session_cookie_secure", "public", "services"],
      "properties": {
        "backend": { "enum": ["postgres", "rabbitmq_redis"] },
        "database": { "enum": ["vm", "cloudsql"] },
        "database_name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "session_cookie_secure": { "type": "boolean" },
        "public": {
          "type": "object",
          "required": ["host", "domain", "dns_zone", "letsencrypt_staging"],
          "properties": {
            "host": { "type": "string" },
            "domain": { "type": "string" },
            "dns_zone": { "type": "string" },
            "letsencrypt_staging": { "type": "boolean" }
          }
        },
        "services": {
          "type": "object",
          "required": ["postgres", "rabbitmq", "redis", "certbot", "fetcher", "history", "ui"],
          "additionalProperties": { "$ref": "#/$defs/service" },
          "properties": {
            "rabbitmq": { "required": ["image"] },
            "redis": { "required": ["image"] },
            "certbot": { "required": ["image"] }
          }
        }
      }
    },
    "ssh": {
      "type": "object",
      "required": ["port", "jump_user", "public_keys"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "jump_user": { "type": "string" },
        "public_keys": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "app": { "properties": { "database": { "const": "cloudsql" } } } } },
      "then": { "required": ["cloudsql"] }
    }
  ]
}
