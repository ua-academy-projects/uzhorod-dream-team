{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citybikes-tracker.pp.ua/config.schema.json",
  "title": "CityBikes infrastructure (infra/config.json)",
  "description": "WHAT is built, in every cloud. Read by Terraform (infra/envs/gcp, infra/envs/aws). Checked against this schema before every run.",
  "type": "object",
  "additionalProperties": true,
  "required": ["prefix", "clouds", "network", "ssh", "vms", "database", "tls", "app", "monitoring"],

  "properties": {
    "prefix": {
      "description": "In front of every name, in every cloud: VMs, accounts, secrets, the network",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,15}$"
    },

    "clouds": {
      "description": "Where the infrastructure is built, and how each cloud calls the generic words of this file (size, os, permissions, database size). Clouds with enabled = true are built side by side",
      "type": "object",
      "additionalProperties": true,
      "minProperties": 1,
      "properties": {
        "gcp": {
          "allOf": [
            { "$ref": "#/$defs/cloud" },
            {
              "required": ["database_private_range"],
              "properties": {
                "database_private_range": { "description": "Free range for Google's side of the private connection to Cloud SQL", "$ref": "#/$defs/cidr" },
                "os": { "additionalProperties": { "description": "An image: project/family", "type": "string" } }
              }
            }
          ]
        },
        "aws": {
          "allOf": [
            { "$ref": "#/$defs/cloud" },
            {
              "properties": {
                "zones": { "description": "The VMs use the first; RDS needs a second one", "minItems": 2 },
                "os": {
                  "additionalProperties": {
                    "description": "An AMI, found by its owner (account id) and name (pattern)",
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["owner", "name"],
                    "properties": {
                      "owner": { "type": "string", "pattern": "^[0-9]{12}$" },
                      "name": { "type": "string" }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },

    "network": {
      "type": "object",
      "additionalProperties": true,
      "required": ["subnet_cidr", "internal_ports"],
      "properties": {
        "subnet_cidr": { "description": "The VMs' subnet, the same in every cloud", "$ref": "#/$defs/cidr" },
        "internal_ports": {
          "description": "TCP ports the VMs open to each other",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/port" }
        }
      }
    },

    "ssh": {
      "type": "object",
      "additionalProperties": true,
      "required": ["user", "bastion_port", "access_public_key_file", "key_ttl_minutes"],
      "properties": {
        "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
        "bastion_port": {
          "description": "The port the bastion's sshd listens on (the only SSH port open to the internet)",
          "type": "integer", "minimum": 1, "maximum": 65535, "not": { "const": 22 }
        },
        "access_public_key_file": {
          "description": "The public half of the key of the current run (role ssh_access writes it; the private half is only in your ssh-agent)",
          "$ref": "#/$defs/pubkey_file"
        },
        "key_ttl_minutes": { "description": "How long the key of a run is valid on the VMs", "type": "integer", "minimum": 5, "maximum": 120 }
      }
    },

    "vms": {
      "description": "The VMs: what they all have, and each one",
      "type": "object",
      "additionalProperties": true,
      "required": ["defaults", "instances"],
      "properties": {
        "defaults": {
          "description": "Every VM gets these. A VM's own size, os, disk_gb, cloud_logging replace them; its permissions are ADDED to these",
          "type": "object",
          "additionalProperties": true,
          "required": ["size", "os", "disk_gb", "cloud_logging", "permissions"],
          "properties": {
            "size": { "$ref": "#/$defs/size" },
            "os": { "$ref": "#/$defs/os" },
            "disk_gb": { "$ref": "#/$defs/disk_gb" },
            "cloud_logging": { "$ref": "#/$defs/cloud_logging" },
            "permissions": { "$ref": "#/$defs/permissions" }
          }
        },
        "instances": {
          "description": "Each VM: what is its own, and only what differs from vms.defaults",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,14}$" },
          "additionalProperties": { "$ref": "#/$defs/vm" }
        }
      }
    },

    "database": {
      "description": "Which PostgreSQL the application uses (type), and the cloud's managed database while it exists (managed). PostgreSQL on a VM = the service postgres in that VM's services",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "vm"],
      "properties": {
        "type": {
          "description": "The database switch: managed = the cloud's own PostgreSQL (Cloud SQL in GCP, RDS in AWS); vm = PostgreSQL in Docker on database.vm, the managed one is removed",
          "enum": ["managed", "vm"]
        },
        "vm": { "description": "The VM that runs PostgreSQL (the service postgres is added to it) while type = vm; never the bastion", "type": "string", "pattern": "^[a-z][a-z0-9-]{0,14}$" },
        "managed": {
          "description": "The managed database (private IP only)",
          "type": "object",
          "additionalProperties": true,
          "required": ["version", "size", "disk_gb", "deletion_protection"],
          "properties": {
            "version": { "description": "PostgreSQL major version", "type": "string", "pattern": "^[0-9]+$" },
            "size": { "description": "A key of clouds.<cloud>.database_sizes", "$ref": "#/$defs/size" },
            "disk_gb": { "$ref": "#/$defs/disk_gb" },
            "deletion_protection": { "description": "false only right before the managed database is removed", "type": "boolean" }
          }
        }
      },
      "if": { "properties": { "type": { "const": "managed" } } },
      "then": { "required": ["managed"] }
    },

    "tls": {
      "description": "The site's certificate (certbot, DNS-01 through Cloudflare), for the domain of each cloud (clouds.<cloud>.domain)",
      "type": "object",
      "additionalProperties": true,
      "required": ["vm", "email", "staging"],
      "properties": {
        "vm": { "type": "string" },
        "email": { "anyOf": [{ "const": "" }, { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" }] },
        "staging": { "description": "true: Let's Encrypt test certificates (not trusted, no rate limits)", "type": "boolean" }
      }
    },

    "app": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "queue_backend", "cache_backend", "citybikes_network", "poll_interval",
        "db_name", "db_user", "rabbitmq_user", "rabbitmq_vhost", "cloudflare_tunnel_protocol"
      ],
      "properties": {
        "queue_backend": { "description": "How History asks Fetcher for data", "enum": ["rabbitmq", "postgres"] },
        "cache_backend": { "description": "Where History keeps the user settings", "enum": ["redis", "postgres"] },
        "citybikes_network": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "poll_interval": { "description": "Seconds between two snapshots", "type": "integer", "minimum": 10 },
        "db_name": { "$ref": "#/$defs/identifier" },
        "db_user": { "$ref": "#/$defs/identifier" },
        "rabbitmq_user": { "$ref": "#/$defs/identifier" },
        "rabbitmq_vhost": { "$ref": "#/$defs/identifier" },
        "cloudflare_tunnel_protocol": { "enum": ["auto", "quic", "http2"] }
      }
    },

    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "alerts"],
      "properties": {
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
        "alerts": {
          "type": "object",
          "required": ["disk_percent", "error_rate_percent", "latency_p95_seconds", "no_snapshots"],
          "propertyNames": { "enum": ["disk_percent", "error_rate_percent", "latency_p95_seconds", "no_snapshots"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "minutes"],
            "properties": {
              "severity": { "enum": ["CRITICAL", "ERROR", "WARNING"] },
              "threshold": { "type": "number", "exclusiveMinimum": 0 },
              "minutes": { "type": "integer", "minimum": 2 }
            }
          }
        }
      }
    }
  },

  "$defs": {
    "cloud": {
      "description": "One cloud: where, and its names for the generic words. Every size, os and permission used in vms and database must be a key of its tables (Terraform checks it)",
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "region", "zones", "domain", "sizes", "os", "permissions", "database_sizes"],
      "properties": {
        "enabled": { "description": "true: this cloud is built", "type": "boolean" },
        "region": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)+-?[0-9]+$" },
        "zones": {
          "description": "The VMs use the first",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)+-?[0-9]+-?[a-z]$" }
        },
        "domain": { "description": "The site's domain in this cloud; \"\": HTTP only", "anyOf": [{ "const": "" }, { "$ref": "#/$defs/hostname" }] },
        "sizes": {
          "description": "size → this cloud's machine type",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/size" },
          "additionalProperties": { "type": "string" }
        },
        "os": {
          "description": "os → this cloud's image",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/os" }
        },
        "permissions": {
          "description": "permission → this cloud's role or policy",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/permission" },
          "additionalProperties": { "type": "string" }
        },
        "database_sizes": {
          "description": "database size → this cloud's database tier / instance class",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/size" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": true,
      "required": ["host", "services"],
      "properties": {
        "host": { "description": "Private IP = subnet + host", "type": "integer", "minimum": 2, "maximum": 254 },
        "size": { "$ref": "#/$defs/size" },
        "os": { "$ref": "#/$defs/os" },
        "disk_gb": { "$ref": "#/$defs/disk_gb" },
        "bastion": { "description": "The only VM with a public IP; exactly one", "type": "boolean" },
        "cloud_logging": { "$ref": "#/$defs/cloud_logging" },
        "services": {
          "description": "The containers on this VM",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["postgres", "redis", "rabbitmq", "fetcher", "history", "ui", "cloudflared"] }
        },
        "permissions": { "description": "Permissions in ADDITION to vms.defaults.permissions", "$ref": "#/$defs/permissions" },
        "secrets": {
          "description": "The secrets the VM may read",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/secret" }
        }
      }
    },
    "size": { "description": "A generic size, such as small", "type": "string", "pattern": "^[a-z][a-z0-9-]{0,15}$" },
    "os": { "description": "A generic OS name, such as ubuntu-24.04", "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,31}$" },
    "permission": { "description": "A generic permission, such as write_logs", "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "permissions": {
      "description": "What the VM's account may do, in generic words (keys of clouds.<cloud>.permissions)",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/permission" }
    },
    "disk_gb": { "type": "integer", "minimum": 10, "maximum": 1000 },
    "cloud_logging": { "description": "Container logs to the cloud's logging (needs the permission write_logs)", "type": "boolean" },
    "secret": {
      "enum": ["db-password", "redis-password", "rabbitmq-password", "cloudflare-tunnel-token", "cloudflare-api-token", "ssh-host-key"]
    },
    "cidr": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])/([0-9]|[12][0-9]|3[0-2])$"
    },
    "port": { "type": "string", "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$" },
    "pubkey_file": { "type": "string", "pattern": "\\.pub$" },
    "hostname": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$" },
    "identifier": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" }
  }
}
