{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citybikes-tracker.pp.ua/config.schema.json",
  "title": "CityBikes infrastructure (infra/config.json)",
  "description": "WHAT is built. Read by Terraform (infra/envs/dev). Checked against this schema before every run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["prefix", "location", "network", "ssh", "vms", "database", "tls", "app", "monitoring"],

  "properties": {
    "prefix": {
      "description": "In front of every name: VMs, service accounts, secrets, the VPC",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,15}$"
    },

    "location": {
      "description": "Where everything is built",
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "zone"],
      "properties": {
        "region": { "type": "string", "pattern": "^[a-z]+-[a-z]+[0-9]$" },
        "zone": { "type": "string", "pattern": "^[a-z]+-[a-z]+[0-9]-[a-z]$" }
      }
    },

    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subnet_cidr", "internal_ports"],
      "properties": {
        "subnet_cidr": { "$ref": "#/$defs/cidr" },
        "internal_ports": {
          "description": "TCP ports the VMs open to each other",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/port" }
        }
      }
    },

    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "bastion_port", "access_public_key_file", "key_ttl_minutes"],
      "properties": {
        "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
        "bastion_port": {
          "description": "The port the bastion's sshd listens on (the only SSH port open to the internet)",
          "type": "integer", "minimum": 1, "maximum": 65535, "not": { "const": 22 }
        },
        "access_public_key_file": {
          "description": "The public half of the key of the current run (role ssh_access writes it; the private half is only in your ssh-agent)",
          "$ref": "#/$defs/pubkey_file"
        },
        "key_ttl_minutes": { "description": "How long the key of a run is valid on the VMs", "type": "integer", "minimum": 5, "maximum": 120 }
      }
    },

    "vms": {
      "description": "The VMs: what they all have, and each one",
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults", "instances"],
      "properties": {
        "defaults": {
          "description": "Every VM gets these. A VM's own machine_type, disk_size_gb, image, cloud_logging replace them; its roles are ADDED to these",
          "type": "object",
          "additionalProperties": false,
          "required": ["machine_type", "disk_size_gb", "image", "cloud_logging", "roles"],
          "properties": {
            "machine_type": { "$ref": "#/$defs/machine_type" },
            "disk_size_gb": { "$ref": "#/$defs/disk_size_gb" },
            "image": { "type": "string" },
            "cloud_logging": { "$ref": "#/$defs/cloud_logging" },
            "roles": { "$ref": "#/$defs/roles" }
          }
        },
        "instances": {
          "description": "Each VM: what is its own, and only what differs from vms.defaults",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,14}$" },
          "additionalProperties": { "$ref": "#/$defs/vm" }
        }
      }
    },

    "database": {
      "description": "Which PostgreSQL the application uses (type), and Cloud SQL while it exists (cloudsql). PostgreSQL on a VM = the service postgres in that VM's services",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "vm"],
      "properties": {
        "type": { "description": "The database switch: type cloudsql = Cloud SQL exists and the application uses it; type vm = PostgreSQL in Docker on database.vm, Cloud SQL is removed" },
        "vm": { "description": "The VM that runs PostgreSQL (the service postgres is added to it) while type = vm; never the bastion", "type": "string", "pattern": "^[a-z][a-z0-9-]{0,14}$" },
        "cloudsql": {
          "description": "Cloud SQL exists while this block is here (private IP only)",
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "tier", "disk_size_gb", "private_range", "deletion_protection"],
          "properties": {
            "version": { "type": "string", "pattern": "^POSTGRES_[0-9]+$" },
            "tier": { "type": "string", "pattern": "^db-" },
            "disk_size_gb": { "type": "integer", "minimum": 10 },
            "private_range": { "description": "Free range for Google's side of the private connection", "$ref": "#/$defs/cidr" },
            "deletion_protection": { "description": "false only right before Cloud SQL is removed (its block taken out)", "type": "boolean" }
          }
        }
      },
      "if": { "properties": { "type": { "const": "cloudsql" } } },
      "then": { "required": ["cloudsql"] }
    },

    "tls": {
      "description": "The site's certificate (certbot, DNS-01 through Cloudflare). domain = \"\": HTTP only",
      "type": "object",
      "additionalProperties": false,
      "required": ["vm", "domain", "email", "staging"],
      "properties": {
        "vm": { "type": "string" },
        "domain": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/hostname" }] },
        "email": { "anyOf": [{ "const": "" }, { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" }] },
        "staging": { "description": "true: Let's Encrypt test certificates (not trusted, no rate limits)", "type": "boolean" }
      }
    },

    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_backend", "cache_backend", "citybikes_network", "poll_interval",
        "db_name", "db_user", "rabbitmq_user", "rabbitmq_vhost", "cloudflare_tunnel_protocol"
      ],
      "properties": {
        "queue_backend": { "description": "How History asks Fetcher for data", "enum": ["rabbitmq", "postgres"] },
        "cache_backend": { "description": "Where History keeps the user settings", "enum": ["redis", "postgres"] },
        "citybikes_network": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "poll_interval": { "description": "Seconds between two snapshots", "type": "integer", "minimum": 10 },
        "db_name": { "$ref": "#/$defs/identifier" },
        "db_user": { "$ref": "#/$defs/identifier" },
        "rabbitmq_user": { "$ref": "#/$defs/identifier" },
        "rabbitmq_vhost": { "$ref": "#/$defs/identifier" },
        "cloudflare_tunnel_protocol": { "enum": ["auto", "quic", "http2"] }
      }
    },
    "monitoring": {
    "description": "Cloud Monitoring (modules/monitoring): the alerts go to this e-mail",
    "type": "object",
    "additionalProperties": false,
    "required": ["email", "disk_used_percent", "silence_minutes", "poll_failures", "uptime_path"],
    "properties": {
      "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" },
      "disk_used_percent": { "description": "A disk of a VM (or of Cloud SQL) fuller than this = an alert", "type": "integer", "minimum": 10, "maximum": 99 },
      "silence_minutes": { "description": "No data from a VM, or no snapshot stored, for this long = an alert", "type": "integer", "minimum": 5, "maximum": 60 },
      "poll_failures": { "description": "More failed polls of History in 15 minutes than this = an alert", "type": "integer", "minimum": 1 },
      "uptime_path": { "description": "What the uptime check opens on tls.domain; it must answer \"db_ok\": true", "type": "string", "pattern": "^/" }
      }
    }
  },

  "$defs": {
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "services"],
      "properties": {
        "host": { "description": "Private IP = subnet + host", "type": "integer", "minimum": 2, "maximum": 254 },
        "machine_type": { "$ref": "#/$defs/machine_type" },
        "disk_size_gb": { "$ref": "#/$defs/disk_size_gb" },
        "image": { "type": "string" },
        "bastion": { "description": "The only VM with a public IP; exactly one", "type": "boolean" },
        "cloud_logging": { "$ref": "#/$defs/cloud_logging" },
        "services": {
          "description": "The containers on this VM",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["postgres", "redis", "rabbitmq", "fetcher", "history", "ui", "cloudflared"] }
        },
        "roles": { "description": "Project roles in ADDITION to vms.defaults.roles", "$ref": "#/$defs/roles" },
        "secrets": {
          "description": "The secrets the VM may read",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/secret" }
        }
      }
    },
    "machine_type": { "type": "string", "pattern": "^[a-z0-9]+-[a-z0-9-]+$" },
    "disk_size_gb": { "type": "integer", "minimum": 10, "maximum": 1000 },
    "cloud_logging": { "description": "Container logs to Cloud Logging (needs roles/logging.logWriter)", "type": "boolean" },
    "roles": {
      "description": "Project roles of the VM's service account",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^roles/[A-Za-z0-9_.]+$" }
    },
    "secret": {
      "enum": [
        "db-password", "redis-password", "rabbitmq-password",
        "cloudflare-tunnel-token", "cloudflare-api-token"
      ]
    },
    "cidr": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])/([0-9]|[12][0-9]|3[0-2])$"
    },
    "port": { "type": "string", "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$" },
    "pubkey_file": { "type": "string", "pattern": "\\.pub$" },
    "hostname": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$" },
    "identifier": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" }
  }
}
