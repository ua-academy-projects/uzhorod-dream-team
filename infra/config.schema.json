{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citybikes-tracker.pp.ua/config.schema.json",
  "title": "CityBikes infrastructure (infra/config.json)",
  "description": "WHAT is built. Read by Terraform (infra/envs/dev). Checked against this schema before every run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["prefix", "location", "network", "ssh", "vm_defaults", "vms", "database", "tls", "app"],

  "properties": {
    "prefix": {
      "description": "In front of every name: VMs, service accounts, secrets, the VPC",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,15}$"
    },

    "location": {
      "description": "Where everything is built",
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "zone"],
      "properties": {
        "region": { "type": "string", "pattern": "^[a-z]+-[a-z]+[0-9]$" },
        "zone": { "type": "string", "pattern": "^[a-z]+-[a-z]+[0-9]-[a-z]$" }
      }
    },

    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subnet_cidr", "internal_ports"],
      "properties": {
        "subnet_cidr": { "$ref": "#/$defs/cidr" },
        "internal_ports": {
          "description": "TCP ports the VMs open to each other",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/port" }
        }
      }
    },

    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "user_public_key_file", "internal_public_key_file"],
      "properties": {
        "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
        "user_public_key_file": { "description": "YOUR key: the bastion accepts it", "$ref": "#/$defs/pubkey_file" },
        "internal_public_key_file": { "description": "The key the other VMs accept", "$ref": "#/$defs/pubkey_file" }
      }
    },

    "vm_defaults": {
      "description": "Every VM gets these. A VM's own machine_type, disk_size_gb, image, cloud_logging replace them; its roles are ADDED to these",
      "type": "object",
      "additionalProperties": false,
      "required": ["machine_type", "disk_size_gb", "image", "cloud_logging", "roles"],
      "properties": {
        "machine_type": { "$ref": "#/$defs/machine_type" },
        "disk_size_gb": { "$ref": "#/$defs/disk_size_gb" },
        "image": { "type": "string" },
        "cloud_logging": { "$ref": "#/$defs/cloud_logging" },
        "roles": { "$ref": "#/$defs/roles" }
      }
    },

    "vms": {
      "description": "Each VM: what is its own, and only what differs from vm_defaults",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,14}$" },
      "additionalProperties": { "$ref": "#/$defs/vm" }
    },

    "database": {
      "description": "Cloud SQL for PostgreSQL, private IP only",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tier", "disk_size_gb", "private_range"],
      "properties": {
        "version": { "type": "string", "pattern": "^POSTGRES_[0-9]+$" },
        "tier": { "type": "string", "pattern": "^db-" },
        "disk_size_gb": { "type": "integer", "minimum": 10 },
        "private_range": { "description": "Free range for Google's side of the private connection", "$ref": "#/$defs/cidr" }
      }
    },

    "tls": {
      "description": "The site's certificate (certbot, DNS-01 through Cloudflare). domain = \"\": HTTP only",
      "type": "object",
      "additionalProperties": false,
      "required": ["vm", "domain", "email", "staging"],
      "properties": {
        "vm": { "type": "string" },
        "domain": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/hostname" }] },
        "email": { "anyOf": [{ "const": "" }, { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" }] },
        "staging": { "description": "true: Let's Encrypt test certificates (not trusted, no rate limits)", "type": "boolean" }
      }
    },

    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_backend", "cache_backend", "citybikes_network", "poll_interval",
        "db_name", "db_user", "rabbitmq_user", "rabbitmq_vhost", "cloudflare_tunnel_protocol"
      ],
      "properties": {
        "queue_backend": { "description": "How History asks Fetcher for data", "enum": ["rabbitmq", "postgres"] },
        "cache_backend": { "description": "Where History keeps the user settings", "enum": ["redis", "postgres"] },
        "citybikes_network": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "poll_interval": { "description": "Seconds between two snapshots", "type": "integer", "minimum": 10 },
        "db_name": { "$ref": "#/$defs/identifier" },
        "db_user": { "$ref": "#/$defs/identifier" },
        "rabbitmq_user": { "$ref": "#/$defs/identifier" },
        "rabbitmq_vhost": { "$ref": "#/$defs/identifier" },
        "cloudflare_tunnel_protocol": { "enum": ["auto", "quic", "http2"] }
      }
    }
  },

  "$defs": {
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "services"],
      "properties": {
        "host": { "description": "Private IP = subnet + host", "type": "integer", "minimum": 2, "maximum": 254 },
        "machine_type": { "$ref": "#/$defs/machine_type" },
        "disk_size_gb": { "$ref": "#/$defs/disk_size_gb" },
        "image": { "type": "string" },
        "bastion": { "description": "The only VM with a public IP; exactly one", "type": "boolean" },
        "cloud_logging": { "$ref": "#/$defs/cloud_logging" },
        "services": {
          "description": "The containers on this VM",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["redis", "rabbitmq", "fetcher", "history", "ui", "cloudflared"] }
        },
        "roles": { "description": "Project roles in ADDITION to vm_defaults.roles", "$ref": "#/$defs/roles" },
        "secrets": {
          "description": "The secrets the VM may read",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/secret" }
        }
      }
    },
    "machine_type": { "type": "string", "pattern": "^[a-z0-9]+-[a-z0-9-]+$" },
    "disk_size_gb": { "type": "integer", "minimum": 10, "maximum": 1000 },
    "cloud_logging": { "description": "Container logs to Cloud Logging (needs roles/logging.logWriter)", "type": "boolean" },
    "roles": {
      "description": "Project roles of the VM's service account",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^roles/[A-Za-z0-9_.]+$" }
    },
    "secret": {
      "enum": [
        "db-password", "redis-password", "rabbitmq-password",
        "cloudflare-tunnel-token", "cloudflare-api-token", "internal-ssh-key"
      ]
    },
    "cidr": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])/([0-9]|[12][0-9]|3[0-2])$"
    },
    "port": { "type": "string", "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$" },
    "pubkey_file": { "type": "string", "pattern": "\\.pub$" },
    "hostname": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$" },
    "identifier": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" }
  }
}
