{#- All URLs are built from config.json backends.<N> (queue_env_cfg); there are no conditions for a specific backend here. -#}
{% set q = queue_env_cfg.queue %}
{% set c = queue_env_cfg.cache %}
{% set d = queue_env_cfg.database %}
{% set s = queue_env_cfg.secrets %}
{% if inventory_hostname == 'history' %}
{% set dhost = lookup('ian.main.osm_config', 'instances.' ~ d.instance ~ '.internal_ip') if d.instance is defined else queue_env_database_host %}
DATABASE_URL={{ d.scheme }}://{{ d.user | ian.main.urlsafe }}:{{ lookup('vars', s.database_password) | ian.main.urlsafe }}@{{ dhost }}:{{ d.port }}/{{ d.path }}{{ '?' ~ d.query if d.query is defined else '' }}
{% endif %}
{% set quser = q.user if q.user is defined else lookup('vars', s.queue_user) %}
QUEUE_URL={{ q.scheme }}://{{ quser | ian.main.urlsafe }}:{{ lookup('vars', s.queue_password) | ian.main.urlsafe }}@{{ lookup('ian.main.osm_config', 'instances.' ~ q.instance ~ '.internal_ip') }}:{{ q.port }}/{{ q.path }}
{% if c %}
REDIS_URL={{ c.scheme }}://:{{ lookup('vars', s.cache_password) | ian.main.urlsafe }}@{{ lookup('ian.main.osm_config', 'instances.' ~ c.instance ~ '.internal_ip') }}:{{ c.port }}
{% endif %}
