[Unit]
Description=osm {{ artifact_service_name }}
After=network-online.target
Wants=network-online.target

[Service]
# queue.env is written by the queue_env role and rewritten by the switch_backend playbook
EnvironmentFile={{ artifact_service_queue_env_file }}
EnvironmentFile={{ artifact_service_config_dir }}/{{ artifact_service_name }}.env
ExecStart={{ artifact_service_bin_dir }}/{{ artifact_service_name }}
Restart=on-failure
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
