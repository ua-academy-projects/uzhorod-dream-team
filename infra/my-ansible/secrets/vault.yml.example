---
# Copy to vault.yml, fill in and encrypt: ansible-vault encrypt secrets/vault.yml
# Passed explicitly: ansible-playbook ian.main.site -e @secrets/vault.yml
vault_pgmq_password: change-me
vault_history_password: change-me          # history on the database VM
vault_cloudsql_history_password: change-me  # history in Cloud SQL; = Terraform TF_VAR_history_pass
vault_rabbit_user: osm
vault_rabbit_password: change-me
vault_redis_password: change-me
vault_cloudflare_api_token: change-me   # Zone:DNS:Edit permission on the domain zone
