
terraform {
  required_version = ">= 1.6"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 6.0, < 8.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

provider "google" {
  region = var.project.region # no default project: the project is created below
}

locals {
  labels = { app = "citybikes", managed-by = "terraform" }
  out    = pathexpand(var.output_dir)

  apis = [
    "cloudresourcemanager.googleapis.com",
    "serviceusage.googleapis.com",
    "iam.googleapis.com",
    "compute.googleapis.com",
    "storage.googleapis.com",
    "secretmanager.googleapis.com",
    "logging.googleapis.com",
    "iamcredentials.googleapis.com",
  ]

  terraform_roles = [
    "roles/compute.admin",                    
    "roles/iam.serviceAccountAdmin",          
    "roles/iam.serviceAccountUser",           
    "roles/secretmanager.admin",              
    "roles/storage.admin",                 
    "roles/resourcemanager.projectIamAdmin",  
    "roles/serviceusage.serviceUsageConsumer"
  ]
}

# APIs
resource "google_project_service" "apis" {
  for_each           = toset(local.apis)
  project            = google_project.this.project_id
  service            = each.value
  disable_on_destroy = false 
}

# Project
resource "google_project" "this" {
  project_id      = var.project.id
  name            = coalesce(var.project.name, var.project.id)
  billing_account = var.project.billing_account
  labels          = local.labels
  deletion_policy = "PREVENT" # `terraform destroy` will not delete the project
}

# Bucket state
resource "google_storage_bucket" "tfstate" {
  project  = google_project.this.project_id
  name     = "${var.project.id}-tfstate"
  location = upper(var.project.region)
  labels   = local.labels

  uniform_bucket_level_access = true       # access by IAM only
  public_access_prevention    = "enforced" # can never become public

  versioning {
    enabled = true # broken state can be rolled back
  }

  lifecycle_rule {
    condition {
      num_newer_versions = 20
      with_state         = "ARCHIVED"
    }
    action {
      type = "Delete"
    }
  }

  lifecycle {
    prevent_destroy = true # the state of everything lives here
  }

  depends_on = [google_project_service.apis]
}

# Service account
resource "google_service_account" "terraform" {
  project      = google_project.this.project_id
  account_id   = "terraform"
  display_name = "Terraform (envs/dev)"
  depends_on   = [google_project_service.apis]
}

resource "google_project_iam_member" "terraform" {
  for_each = toset(local.terraform_roles)
  project  = google_project.this.project_id
  role     = each.value
  member   = "serviceAccount:${google_service_account.terraform.email}"
}

data "google_client_openid_userinfo" "me" {}

resource "google_service_account_iam_member" "impersonate" {
  service_account_id = google_service_account.terraform.name
  role               = "roles/iam.serviceAccountTokenCreator"
  member             = "user:${data.google_client_openid_userinfo.me.email}"
}

# Files outside the repository
resource "local_sensitive_file" "env" {
  filename             = "${local.out}/terraform.env"
  file_permission      = "0600"
  directory_permission = "0700"
  content              = <<-EOT
    # Generated by infra/bootstrap. Do NOT commit. Load before working with infra/envs/dev:
    #   source ${local.out}/terraform.env
    # Terraform then runs AS the service account ${google_service_account.terraform.email}

    export GOOGLE_IMPERSONATE_SERVICE_ACCOUNT="${google_service_account.terraform.email}"
    export GOOGLE_BACKEND_IMPERSONATE_SERVICE_ACCOUNT="${google_service_account.terraform.email}"
    export TF_STATE_BUCKET="${google_storage_bucket.tfstate.name}"

    export TF_VAR_project_id="${google_project.this.project_id}"
    export TF_VAR_region="${var.project.region}"
    export TF_VAR_zone="${var.project.zone}"
    export TF_VAR_my_ip="${var.my_ip}"
  EOT
}
