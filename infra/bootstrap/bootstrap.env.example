# copy to bootstrap.env and fill in
PROJECT_ID=osm-example-123456        # globally unique, 6-30 chars, lowercase letters/digits/hyphens
PROJECT_NAME="OSM"                   # display name
BILLING_ACCOUNT=XXXXXX-XXXXXX-XXXXXX # gcloud billing accounts list
ORG_ID=123456789012                  # gcloud organizations list
REGION=europe-west4

# optional, default shown (bucket names are globally unique)
# STATE_BUCKET=${PROJECT_ID}-tfstate

