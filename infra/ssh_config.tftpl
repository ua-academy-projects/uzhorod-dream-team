# Generated by Terraform (infra/ssh_config.tftpl). Do not edit by hand, regenerate:
#   terraform output -raw ssh_config > ~/.ssh/osm_config
# and add to ~/.ssh/config:   Include ~/.ssh/osm_config
# The bastion address is ephemeral, so regenerate after every apply that recreates the bastion.

Host ${join(" ", all_hosts)}
    User ${user}
    IdentityFile ${identity_file}
    IdentitiesOnly yes
    ServerAliveInterval 30

%{ for name, inst in bastions ~}
# ${name}: jump host with a public address
Host ${name}
    HostName ${public_ips[name]}
    StrictHostKeyChecking accept-new

%{ endfor ~}
%{ for name, inst in private_hosts ~}
# ${name} (${inst.internal_ip}): reachable only through the bastion
Host ${name}
    HostName ${inst.internal_ip}
    ProxyJump ${bastion_name}
    StrictHostKeyChecking accept-new

%{ endfor ~}
