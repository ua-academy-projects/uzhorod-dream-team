{
  "prefix": "citybikes",
  "location": { "region": "europe-central2", "zone": "europe-central2-a" },
  "network": {
    "subnet_cidr": "10.20.0.0/24",
    "internal_ports": ["80", "443", "5672", "6379", "8002", "15672"]
  },
  "ssh": {
    "user": "citybikes",
    "bastion_port": 505,
    "access_public_key_file": "~/.ssh/citybikes_access.pub",
    "key_ttl_minutes": 15
  },
  "vms": {
    "defaults": {
      "machine_type": "e2-small",
      "disk_size_gb": 10,
      "image": "ubuntu-os-cloud/ubuntu-2404-lts-amd64",
      "cloud_logging": true,
      "roles": ["roles/logging.logWriter", "roles/monitoring.metricWriter"]
    },
    "instances": {
      "db": { "host": 50, "disk_size_gb": 20, "services": ["redis", "rabbitmq"], "secrets": ["redis-password", "rabbitmq-password"] },
      "fetcher": { "host": 51, "services": ["fetcher"], "secrets": ["rabbitmq-password", "db-password"] },
      "history": { "host": 52, "services": ["history"], "secrets": ["db-password", "rabbitmq-password", "redis-password"] },
      "ui": { "host": 53, "disk_size_gb": 15, "services": ["ui", "cloudflared"], "secrets": ["cloudflare-tunnel-token", "cloudflare-api-token"] },
      "bastion": { "host": 54, "services": [], "bastion": true, "secrets": ["ssh-host-key"] }
    }
  },
  "database": {
    "type": "cloudsql",
    "vm": "db",
    "cloudsql": {
      "version": "POSTGRES_16",
      "tier": "db-f1-micro",
      "disk_size_gb": 10,
      "private_range": "10.21.0.0/24",
      "deletion_protection": false
    }
  },
  "tls": { "vm": "ui", "domain": "citybikes-tracker.pp.ua", "email": "fikusivan777@gmail.com", "staging": false },
  "app": {
    "queue_backend": "postgres",
    "cache_backend": "postgres",
    "citybikes_network": "pittsburgh",
    "poll_interval": 60,
    "db_name": "citybikes",
    "db_user": "citybikes_app",
    "rabbitmq_user": "citybikes",
    "rabbitmq_vhost": "citybikes",
    "cloudflare_tunnel_protocol": "auto"
  },
  "monitoring": {
    "email": "fikusivan777@gmail.com",
    "alerts": {
      "disk_percent":        { "severity": "WARNING",  "threshold": 40, "minutes": 5 },
      "error_rate_percent":  { "severity": "CRITICAL", "threshold": 5,  "minutes": 5 },
      "latency_p95_seconds": { "severity": "ERROR",    "threshold": 1,  "minutes": 10 },
      "no_snapshots":        { "severity": "ERROR",                     "minutes": 15 }
    }
  }
}