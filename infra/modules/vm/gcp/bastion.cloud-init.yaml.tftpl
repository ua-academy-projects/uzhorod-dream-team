#cloud-config

package_update: true
packages: [jq]

ssh_deletekeys: true
ssh_genkeytypes: []


write_files:
  - path: /etc/ssh/sshd_config.d/10-port.conf
    content: |
      Port ${ssh_port}

  - path: /etc/ssh/sshd_config.d/20-jump-only.conf
    content: |
      # Jumps only (ssh -W, ProxyJump): no shell, no commands, no file copies.
      HostKey /etc/ssh/ssh_host_ed25519_key
      ForceCommand echo "${prefix} bastion: jump host only"
      PermitTTY no
      AllowTcpForwarding local
      PermitOpen *:22
      AllowAgentForwarding no
      AllowStreamLocalForwarding no
      X11Forwarding no
      PermitTunnel no
      GatewayPorts no
      PermitUserRC no

  - path: /etc/apt/apt.conf.d/52${prefix}-reboot
    content: |
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "03:00";

  - path: /usr/local/sbin/${prefix}-secret
    permissions: "0755"
    content: |
      #!/bin/sh

      set -u
      name="$1"
      metadata=http://metadata.google.internal/computeMetadata/v1

      tries=0
      while :; do
        project=$(curl -fsS -H "Metadata-Flavor: Google" "$metadata/project/project-id")
        token=$(curl -fsS -H "Metadata-Flavor: Google" "$metadata/instance/service-accounts/default/token" | jq -r .access_token)

        # the token goes to curl through its config on stdin, never as an argument (those are visible in ps)
        if answer=$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl -sS --fail-with-body -K - \
            "https://secretmanager.googleapis.com/v1/projects/$project/secrets/$name/versions/latest:access"); then
          printf '%s' "$answer" | jq -r .payload.data | base64 -d
          exit 0
        fi

        # no version yet (or no network yet): wait; anything else (e.g. permission denied): fail now
        case "$answer" in
          ""|*NOT_FOUND*) ;;
          *) echo "$name: $answer" >&2; exit 1 ;;
        esac
        tries=$((tries + 1))
        if [ "$tries" -ge 60 ]; then echo "$name: still no value after 30 minutes" >&2; exit 1; fi
        echo "$name: no value yet, waiting" >&2
        sleep 30
      done

  - path: /usr/local/sbin/${prefix}-bastion-setup
    permissions: "0755"
    content: |
      #!/bin/sh

      set -eu
      export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

      # 1. The host key, from Secret Manager (this VM's service account may read its own secrets only).
      umask 077
      ${prefix}-secret ${host_key_secret} > /etc/ssh/ssh_host_ed25519_key
      ssh-keygen -y -f /etc/ssh/ssh_host_ed25519_key > /etc/ssh/ssh_host_ed25519_key.pub
      umask 022

      # 2. sshd: the port and jump-only (files above), applied only if the configuration is valid.
      install -d -m 0755 /run/sshd   # sshd -t needs it; sshd has not run yet at first boot
      sshd -t
      systemctl daemon-reload
      systemctl restart ssh.socket

      # 3. Ops Agent: disk, memory and CPU from inside, for Cloud Monitoring.
      curl -sSfo /tmp/add-ops-agent-repo.sh https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
      bash /tmp/add-ops-agent-repo.sh --also-install

%{ if tailscale ~}
  - path: /etc/sysctl.d/90-${prefix}-forward.conf
    content: |
      net.ipv4.ip_forward = 1
      net.ipv6.conf.all.forwarding = 1

  - path: /usr/local/sbin/${prefix}-tailscale
    permissions: "0755"
    content: |
      #!/bin/sh

      set -eu
      export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

      sysctl -q --system
      curl -fsSL https://tailscale.com/install.sh | sh

      umask 077
      trap 'rm -f /run/${prefix}-tailscale-key' EXIT
      ${prefix}-secret ${tailscale_secret} > /run/${prefix}-tailscale-key
      tailscale up --auth-key="file:/run/${prefix}-tailscale-key" --hostname="${hostname}" \
        --advertise-tags="tag:${prefix}-router" --advertise-routes="${subnet}" \
        --accept-routes --snat-subnet-routes=false
%{ endif ~}

runcmd:
  - /usr/local/sbin/${prefix}-bastion-setup
%{ if tailscale ~}
  - /usr/local/sbin/${prefix}-tailscale
%{ endif ~}
