# Base URL of the History service. Leave empty in development to use the Vite proxy (/api -> history service).
# For a production build (npm run build:frontend) set it, e.g. http://localhost:3001: it is baked in at build time.
VITE_API_URL=

# Backend address used by the Vite dev proxy
VITE_PROXY_TARGET=http://localhost:3001
