server {
    listen 80;
    listen [::]:80;

    server_name ${DOMEN} www.${DOMEN};
    return 301 https://${DOMEN}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name ${DOMEN} www.${DOMEN};

    ssl_certificate /etc/letsencrypt/live/${DOMEN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMEN}/privkey.pem;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://${HISTORY_HOST}:${HISTORY_PORT};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}