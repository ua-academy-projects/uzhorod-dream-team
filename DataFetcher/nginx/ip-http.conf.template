server {
    listen 80;
    server_name _;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }
    location = /healthz {
        return 200 "ok\n";
    }
    location / {
        return 301 https://__PUBLIC_IP__$request_uri;
    }
}
