#!/usr/bin/env bash
set -Eeuo pipefail

readonly MARKER=/var/lib/kyiv-air/startup-complete
[[ -f "$MARKER" ]] && exit 0
(( EUID == 0 )) || { echo 'Run startup provisioning as root.' >&2; exit 1; }
umask 077

%{ for key, value in environment ~}
export ${key}='${replace(value, "'", "'\"'\"'")}'
%{ endfor ~}

printf '%s' '${script}' | base64 --decode | bash
install -d -m 0700 /var/lib/kyiv-air
touch "$MARKER"
