ENVIRONMENT=development
PORT=8081
ALLOWED_ORIGINS=http://192.168.1.204:5173

# Provisioning derives DATABASE_URL, REDIS_URL and RABBITMQ_URL from credentials and VM addresses.
# PORT and ALLOWED_ORIGINS also follow the Vagrant topology.
SYNC_INTERVAL=15m
BACKFILL_THRESHOLD=1h
DEFAULT_BACKFILL_DURATION=720h
FETCHER_TIMEOUT=1m
SESSION_TTL=720h
SESSION_COOKIE_SECURE=false
SESSION_REDIS_TIMEOUT=1s

RABBITMQ_REQUEST_QUEUE=fetcher.sync.requests.v1
RABBITMQ_CONNECTION_TIMEOUT=5s
RABBITMQ_RECONNECT_INTERVAL=5s
