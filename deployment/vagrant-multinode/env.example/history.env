ENVIRONMENT=development
PORT=8081
ALLOWED_ORIGINS=http://192.168.1.204

# Provisioning derives backend URLs and POSTGRES_ONLY from credentials, VM addresses and the selected mode.
# Provisioning sets PORT. Set ALLOWED_ORIGINS to comma-separated browser origins, including https:// for public domains.
# Provisioning always includes the bastion LAN origin alongside configured origins.
SYNC_INTERVAL=15m
BACKFILL_THRESHOLD=1h
DEFAULT_BACKFILL_DURATION=720h
FETCHER_TIMEOUT=1m
SESSION_TTL=720h
SESSION_COOKIE_SECURE=false
SESSION_STORE_TIMEOUT=1s

RABBITMQ_REQUEST_QUEUE=fetcher.sync.requests.v1
RABBITMQ_CONNECTION_TIMEOUT=5s
RABBITMQ_RECONNECT_INTERVAL=5s

# Provisioning sets POSTGRES_ONLY from the Vagrant invocation.
