ENVIRONMENT=development
PORT=8081
FETCHER_SERVICE_URL=http://192.168.1.202:8080
ALLOWED_ORIGINS=http://192.168.1.204:5173

# Provisioning derives DATABASE_URL and REDIS_URL from db.env and VM addresses.
# PORT, FETCHER_SERVICE_URL and ALLOWED_ORIGINS also follow the Vagrant topology.
SYNC_INTERVAL=15m
BACKFILL_THRESHOLD=1h
DEFAULT_BACKFILL_DURATION=720h
FETCHER_TIMEOUT=1m
SESSION_TTL=720h
SESSION_COOKIE_SECURE=false
SESSION_REDIS_TIMEOUT=1s
