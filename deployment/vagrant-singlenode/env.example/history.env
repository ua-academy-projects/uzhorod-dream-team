ENVIRONMENT=development
PORT=8081
FETCHER_SERVICE_URL=http://127.0.0.1:8080
ALLOWED_ORIGINS=http://localhost:5173

# DATABASE_URL and REDIS_URL are generated by provisioning.
SYNC_INTERVAL=15m
BACKFILL_THRESHOLD=1h
DEFAULT_BACKFILL_DURATION=720h
FETCHER_TIMEOUT=1m
SESSION_TTL=720h
SESSION_COOKIE_SECURE=false
SESSION_REDIS_TIMEOUT=1s
