ENVIRONMENT=development
PORT=8081
ALLOWED_ORIGINS=http://localhost:5173

# DATABASE_URL, REDIS_URL and RABBITMQ_URL are generated by provisioning.
SYNC_INTERVAL=15m
BACKFILL_THRESHOLD=1h
DEFAULT_BACKFILL_DURATION=720h
FETCHER_TIMEOUT=1m
SESSION_TTL=720h
SESSION_COOKIE_SECURE=false
SESSION_REDIS_TIMEOUT=1s

RABBITMQ_REQUEST_QUEUE=fetcher.sync.requests.v1
RABBITMQ_CONNECTION_TIMEOUT=5s
RABBITMQ_RECONNECT_INTERVAL=5s
