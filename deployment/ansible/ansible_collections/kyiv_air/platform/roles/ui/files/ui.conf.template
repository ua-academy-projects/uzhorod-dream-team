server {
    listen 8080;
    server_name _;

    return 308 https://${CERTBOT_DOMAIN}$request_uri;
}

server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/${CERTBOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERTBOT_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;
    set $history_upstream ${HISTORY_URL};

    location /api/v1/ {
        proxy_pass $history_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 8082;
    server_name _;

    location = /nginx_status {
        stub_status;
        access_log off;
    }
}
