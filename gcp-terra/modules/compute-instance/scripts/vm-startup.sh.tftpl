
#!/usr/bin/env bash
set -euo pipefail

mkdir -p /opt/datamonitor-scripts

cat > /opt/datamonitor-scripts/install-docker.sh <<'INSTALL_DOCKER_SCRIPT'
${install_docker_script}
INSTALL_DOCKER_SCRIPT

cat > /opt/datamonitor-scripts/startup-service.sh <<'STARTUP_SERVICE_SCRIPT'
${startup_service_script}
STARTUP_SERVICE_SCRIPT

cat > /opt/datamonitor-scripts/compose.yml <<'COMPOSE_CONFIG'
${compose_config}
COMPOSE_CONFIG
cat > /opt/datamonitor-scripts/nginx.conf <<'NGINX_CONFIG'
${nginx_config}
NGINX_CONFIG

cat > /opt/datamonitor-scripts/setup-ui-https.sh <<'SETUP_HTTPS'
${setup_https_script}
SETUP_HTTPS
cat > /opt/datamonitor-scripts/ip-http.conf.template <<'NGINX_HTTP'
${nginx_http_template}
NGINX_HTTP
cat > /opt/datamonitor-scripts/ip-https.conf.template <<'NGINX_HTTPS'
${nginx_https_template}
NGINX_HTTPS

chmod 700 /opt/datamonitor-scripts/*.sh

%{ if service_role == "history" }bash%{ else }exec bash%{ endif } /opt/datamonitor-scripts/startup-service.sh \
  "${service_role}" \
  "${project_id}" \
  "${tunnel_token_secret_id}" \
  "${ip_https}"
