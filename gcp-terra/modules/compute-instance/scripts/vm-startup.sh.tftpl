#!/usr/bin/env bash
set -euo pipefail
umask 077

# Only non-secret deployment settings are kept on disk.
${startup_exports}
export APP_DIR=/opt/datamonitor
SETTINGS_DIR=/etc/datamonitor
install -d -m 700 "$SETTINGS_DIR"
SETTINGS_TMP="$(mktemp "$SETTINGS_DIR/deploy.env.XXXXXX")"
trap 'rm -f "$SETTINGS_TMP"' EXIT
for key in APP_BACKEND DATABASE_PROVIDER DATABASE_HOST DATABASE_NAME INSTANCE_CONNECTION_NAME SERVICE_ROLE PROJECT_ID ENV_SECRET_ID IP_HTTPS REPO_URL REPO_REF APP_DIR; do
  printf 'export %s=%q\n' "$key" "$${!key}"
done > "$SETTINGS_TMP"
mv "$SETTINGS_TMP" "$SETTINGS_DIR/deploy.env"

if ! command -v git >/dev/null || ! command -v curl >/dev/null || ! python3 -c 'import yaml' >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y git curl python3 python3-yaml ca-certificates
fi

# Resolve the configured ref on first boot or when the source setting changes.
# Subsequent boots use the existing checkout; updates are explicit deployments.
SOURCE="$REPO_URL $REPO_REF $ENV_SECRET_ID"
if [[ ! -d "$APP_DIR/.git" ]]; then
  git clone --no-checkout "$REPO_URL" "$APP_DIR"
fi
if [[ ! -f "$SETTINGS_DIR/source" ]] || [[ "$(cat "$SETTINGS_DIR/source")" != "$SOURCE" ]]; then
  git -C "$APP_DIR" remote set-url origin "$REPO_URL"
  git -C "$APP_DIR" fetch origin "$REPO_REF"
  git -C "$APP_DIR" checkout --detach FETCH_HEAD
  printf '%s\n' "$SOURCE" > "$SETTINGS_DIR/source"
fi

exec bash "$APP_DIR/gcp-terra/scripts/deploy.sh" --boot
